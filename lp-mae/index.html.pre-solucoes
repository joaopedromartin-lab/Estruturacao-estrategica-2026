          { strong: 'Ambientes:',             text: '1 LP de conversão (entregue na EE) + até 2 ajustes/mês. SLA: ajustes em até 4h úteis.' },
          { strong: 'Relatórios:',            text: 'dashboard em tempo real + relatório executivo mensal + análise estratégica trimestral.' },
          { strong: 'Atendimento:',           text: 'gestor de projetos + coordenador + gerente. Respostas em até 4h úteis. Urgências em horário comercial: imediato.' },
          { strong: 'Reuniões:',              text: '1 weekly operacional (1h) + 1 weekly estratégica (1h).' },
          { strong: 'Inteligência:',          text: 'data analytics / CRM dedicado.' }
        ]
      }
    };

    var SOLUTIONS = {
      'ee':        { title: 'Estruturação Estratégica',                                isBundle: false },
      'bundle-s':  { title: 'Estruturação Estratégica + Executar (Bundle · Pack S)',  isBundle: true, packSize: 's'  },
      'bundle-m':  { title: 'Estruturação Estratégica + Executar (Bundle · Pack M)',  isBundle: true, packSize: 'm'  },
      'bundle-l':  { title: 'Estruturação Estratégica + Executar (Bundle · Pack L)',  isBundle: true, packSize: 'l'  },
      'bundle-xl': { title: 'Estruturação Estratégica + Executar (Bundle · Pack XL)', isBundle: true, packSize: 'xl' }
    };

    // ===== Estado global (sessionStorage, reseta por sessão) =====
    var STORAGE_KEY = 'v4-proposal';
    function loadState() {
      try {
        var raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch (e) { return null; }
    }
    function saveState(state) {
      try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
    }

    window.V4Proposal = {
      solution: null,                 // chave em SOLUTIONS
      addons: { socialMedia: false }, // adicionais escolhidos
      get: function () { return { solution: this.solution, addons: Object.assign({}, this.addons) }; },
      select: function (solutionKey) {
        if (solutionKey === null) {
          this.solution = null;
          saveState(this.get());
          window.dispatchEvent(new CustomEvent('v4-proposal-change', { detail: this.get() }));
          return true;
        }
        if (!SOLUTIONS[solutionKey]) return false;
        this.solution = solutionKey;
        saveState(this.get());
        window.dispatchEvent(new CustomEvent('v4-proposal-change', { detail: this.get() }));
        return true;
      },
      toggleAddon: function (name) {
        if (!(name in this.addons)) return;
        this.addons[name] = !this.addons[name];
        saveState(this.get());
        window.dispatchEvent(new CustomEvent('v4-proposal-change', { detail: this.get() }));
      },
      clear: function () {
        this.solution = null;
        this.addons = { socialMedia: false };
        try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}
        window.dispatchEvent(new CustomEvent('v4-proposal-change', { detail: this.get() }));
      }
    };

    // F5 sempre reseta a proposta — não restauramos do sessionStorage no load
    try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}

    // ===== Render =====
    function buildItemHTML(weekLabel, text) {
      var li = '<li class="ee-proposal__item">';
      li += '<span class="ee-proposal__check" aria-hidden="true"></span>';
      if (weekLabel) li += '<span><span class="ee-proposal__week-label">' + weekLabel + ' ·</span> ' + escapeHTML(text) + '</span>';
      else li += '<span>' + text + '</span>';
      return li + '</li>';
    }
    function escapeHTML(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function chevronSvg() {
      return '<svg class="ee-proposal__week-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
    }
    function buildWeek(label, title, items, notice) {
      var itemsHTML = items.map(function (it) {
        return '<li><span class="ee-proposal__week-bullet" aria-hidden="true"></span><span>' + escapeHTML(it) + '</span></li>';
      }).join('');
      return ''
        + '<article class="ee-proposal__week">'
        +   '<button type="button" class="ee-proposal__week-toggle" aria-expanded="false">'
        +     '<span class="ee-proposal__week-num">' + escapeHTML(label) + ' ·</span>'
        +     '<span class="ee-proposal__week-title">' + escapeHTML(title) + '</span>'
        +     chevronSvg()
        +   '</button>'
        +   '<div class="ee-proposal__week-panel">'
        +     '<div class="ee-proposal__week-panel-inner">'
        +       (notice ? '<p class="ee-proposal__week-notice">' + escapeHTML(notice) + '</p>' : '')
        +       '<ul class="ee-proposal__week-list">' + itemsHTML + '</ul>'
        +     '</div>'
        +   '</div>'
        + '</article>';
    }

    function renderEEList() {
      var listEl = document.getElementById('ee-proposal-list-ee');
      if (!listEl) return;
      var model = (window.V4SalesModel && window.V4SalesModel.value) || null;
      var html = '';

      // Semana 01 e 02 (fixas)
      var w1 = WEEKS[1]; html += buildWeek(w1.label, w1.title, w1.items);
      var w2 = WEEKS[2]; html += buildWeek(w2.label, w2.title, w2.items);

      // Semana 03 — varia conforme o modelo de vendas
      var w3 = WEEKS[3];
      var s3 = (model && w3.byModel[model]) ? w3.byModel[model] : null;
      if (s3) {
        html += buildWeek(w3.label, s3.title, s3.items);
      } else {
        html += buildWeek(
          w3.label,
          'Estrutura da Operação',
          ['Selecione um modelo de vendas no topo da página para detalhar a Semana 3.'],
          'Conteúdo personalizado por modelo (PDV / Inside Sales / E-commerce).'
        );
      }

      // Semana 04
      var w4 = WEEKS[4]; html += buildWeek(w4.label, w4.title, w4.items);

      listEl.innerHTML = html;
    }

    function renderExecutarList(packSize) {
      var listEl = document.getElementById('ee-proposal-list-executar');
      if (!listEl) return;
      var pack = PACKS[packSize];
      if (!pack) { listEl.innerHTML = ''; return; }
      var html = '';
      pack.items.forEach(function (item) {
        html += '<li class="ee-proposal__item">';
        html +=   '<span class="ee-proposal__check" aria-hidden="true"></span>';
        html +=   '<span><strong>' + escapeHTML(item.strong) + '</strong> ' + escapeHTML(item.text) + '</span>';
        html += '</li>';
      });
      listEl.innerHTML = html;
    }

    function render() {
      var section = document.getElementById('proposta');
      if (!section) return;

      var state = window.V4Proposal.get();
      var solutionKey = state.solution;

      if (!solutionKey || !SOLUTIONS[solutionKey]) {
        section.setAttribute('data-state', 'empty');
        return;
      }
      section.setAttribute('data-state', 'filled');

      var sol = SOLUTIONS[solutionKey];
      var model = (window.V4SalesModel && window.V4SalesModel.value) || null;
      var modelLabel = (window.V4SalesModel && window.V4SalesModel.label) || null;

      // Header da proposta
      var titleEl = document.getElementById('ee-proposal-pack-title');
      var metaEl  = document.getElementById('ee-proposal-pack-meta');
      if (titleEl) titleEl.textContent = 'Você escolheu: ' + sol.title;
      if (metaEl) {
        metaEl.innerHTML = modelLabel
          ? 'Modelo de vendas: <strong>' + escapeHTML(modelLabel) + '</strong>'
          : '<em style="opacity:.7">Selecione um modelo de vendas no hero para personalizar a Semana 3.</em>';
      }

      // Lista da Estruturação
      renderEEList();

      // Lista do Executar Pack (se for bundle)
      var groupExe = document.getElementById('ee-proposal-group-executar');
      var labelEl  = document.getElementById('ee-proposal-pack-label');
      if (sol.isBundle && PACKS[sol.packSize]) {
        if (groupExe) groupExe.hidden = false;
        if (labelEl)  labelEl.textContent = PACKS[sol.packSize].label;
        renderExecutarList(sol.packSize);
      } else {
        if (groupExe) groupExe.hidden = true;
      }

      // Heading dinâmico (acessibilidade + visual)
      var headingEl = document.getElementById('ee-proposal-heading');
      if (headingEl) headingEl.textContent = 'Sua proposta personalizada';

      // Addon Social Media foi movido pra seção de Preços (antes do CTA).
      // Aqui só garantimos que E.E sozinho não carregue o add-on de bundle.
      if (!sol.isBundle && state.addons.socialMedia) {
        window.V4Proposal.addons.socialMedia = false;
        try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(window.V4Proposal.get())); } catch (e) {}
      }

      // Total (placeholder por enquanto — quando user passar valores reais, calcula aqui)
      // O HTML já tem placeholders; mantemos como está.
    }

    // ===== Toggle do accordion (event delegation — sobrevive aos re-renders do EE list) =====
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.ee-proposal__week-toggle');
      if (!btn) return;
      var panel = btn.nextElementSibling;
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (panel && panel.classList) panel.classList.toggle('is-open', !isOpen);
    });

    // ===== Wiring =====
    document.addEventListener('DOMContentLoaded', function () {
      // 1) Cada "Seguir com essa solução" → V4Proposal.select(value) + scroll
      document.querySelectorAll('[data-pack-cta]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-pack-cta');
          if (!window.V4Proposal.select(key)) return;
          var target = document.getElementById('proposta');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // 2) Toggle do addon Social Media (agora nos Preços, antes do CTA)
      var addonBtn = document.querySelector('.ee-proposal__addon[data-addon="socialMedia"] .ee-proposal__addon-controls');
      if (addonBtn) {
        addonBtn.addEventListener('click', function (e) {
          e.preventDefault();
          window.V4Proposal.toggleAddon('socialMedia');
        });
      }
      // 2b) Estado visual do addon — independente da proposta (pode alternar antes de escolher)
      function renderAddonVisual() {
        var addonEl = document.querySelector('.ee-proposal__addon[data-addon="socialMedia"]');
        if (!addonEl) return;
        var on = !!(window.V4Proposal.addons && window.V4Proposal.addons.socialMedia);
        addonEl.setAttribute('data-checked', on ? 'true' : 'false');
        var input = addonEl.querySelector('.ee-proposal__addon-input');
        if (input) input.checked = on;
        var b = addonEl.querySelector('.ee-proposal__addon-controls');
        if (b) {
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          var act = b.querySelector('.ee-proposal__addon-action');
          if (act) act.textContent = on ? 'Pacote adicionado' : 'Adicionar este pacote';
        }
      }

      // 3) Listeners pra re-render
      window.addEventListener('v4-proposal-change',     render);
      window.addEventListener('v4-proposal-change',     renderAddonVisual);
      window.addEventListener('v4-sales-model-change',  render);

      // Render inicial (caso já exista estado salvo na sessão)
      render();
      renderAddonVisual();
    });
  })();

  // ── PREÇOS: imagens dos packs variam conforme o modelo de vendas selecionado ──
  // Arquivos: assets/bundlePack{S|M|L|XL}-{PDV|Inside|ECOM}.png
  document.addEventListener('DOMContentLoaded', function () {
    var articles = document.querySelectorAll('.ee-pricing__pack-detail');
    if (!articles.length) return;
    var SUFFIX = { 'pdv': 'PDV', 'inside-sales': 'Inside', 'e-commerce': 'ECOM' };
    var SIZE   = { s: 'S', m: 'M', l: 'L', xl: 'XL' };

    function update() {
      var model = (window.V4SalesModel && window.V4SalesModel.value) || null;
      var suffix = model && SUFFIX[model];
      if (!suffix) return; // sem modelo escolhido: mantém a imagem atual
      articles.forEach(function (art) {
        var size = (art.id || '').replace('ee-pack-detail-', '');
        if (!SIZE[size]) return; // pula o detalhe E.E (não é imagem de pack)
        var img = art.querySelector('img');
        if (img) img.src = 'assets/bundlePack' + SIZE[size] + '-' + suffix + '.png';
      });
    }
    window.addEventListener('v4-sales-model-change', update);
    update();
  });

  // ── BUNDLE: toggle entre os 4 packs (S / M / L / XL) ──
  document.addEventListener('DOMContentLoaded', function () {
    var packTabs = document.querySelectorAll('.ee-pricing__pack-tab');
    if (!packTabs.length) return;
    var packDetails = document.querySelectorAll('.ee-pricing__pack-detail');

    var pricingSection = document.getElementById('precos');
    var bundleCta = document.getElementById('ee-bundle-cta');
    function activatePack(size) {
      packTabs.forEach(function (t) {
        var isActive = t.getAttribute('data-pack-size') === size;
        t.classList.toggle('is-active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        t.setAttribute('tabindex', isActive ? '0' : '-1');
      });
      packDetails.forEach(function (d) {
        d.classList.toggle('is-active', d.getAttribute('aria-labelledby') === 'ee-pack-tab-' + size);
      });
      // Marca a solução ativa na seção: o CSS esconde o header e o rodapé de "Bundle"
      // (Social Media + CTA único) quando é E.E sozinho.
      if (pricingSection) pricingSection.setAttribute('data-active-pack', size);
      // O CTA único do bundle aponta pro pack ativo (E.E tem CTA próprio no seu detalhe)
      if (bundleCta && size !== 'ee') bundleCta.setAttribute('data-pack-cta', 'bundle-' + size);
    }

    packTabs.forEach(function (tab, idx) {
      tab.addEventListener('click', function () {
        activatePack(tab.getAttribute('data-pack-size'));
      });
      tab.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          var nextIdx = e.key === 'ArrowRight'
            ? (idx + 1) % packTabs.length
            : (idx - 1 + packTabs.length) % packTabs.length;
          var next = packTabs[nextIdx];
          activatePack(next.getAttribute('data-pack-size'));
          next.focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          activatePack(packTabs[0].getAttribute('data-pack-size'));
          packTabs[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          activatePack(packTabs[packTabs.length - 1].getAttribute('data-pack-size'));
          packTabs[packTabs.length - 1].focus();
        }
      });
    });
  });
})();
</script>

<!-- ============================================================ -->
<!-- FOOTER (same as reference)                                    -->
<!-- ============================================================ -->
<footer class="ee-footer">
  <p class="ee-footer__line">Inimigos da <em>Inércia</em></p>
</footer>

</div><!-- .wp-site-blocks -->

<!-- GSAP + ScrollTrigger + Splitting.js (Scroll Text Reveal component) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://unpkg.com/splitting/dist/splitting.min.js"></script>

<!-- Lucide Icons (icon system) -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>



<script>
document.addEventListener('DOMContentLoaded', function() {

  // ── Lucide icons (replace [data-lucide] placeholders with inline SVG) ──
  if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
    lucide.createIcons();
  }

  // ── SLIDE-UP REVEAL DOS TÍTULOS (entrada na viewport) ──
  (function titlesSlideUp() {
    var SEL = [
      '.ee-auth__who-title', '.ee-recognition__title',
      '.ee-clients__title', '.ee-cases__heading', '.ee-mission__title',
      '.ee-method__title', '.ee-structure__title', '.ee-foru__title',
      '.ee-define__heading', '.ee-roadmap__heading', '.ee-grow__title',
      '.ee-handoff__title', '.ee-sim__title', '.ee-warranty__title',
      '.ee-ecosystem30__title'
    ].join(',');
    var titles = Array.prototype.slice.call(document.querySelectorAll(SEL));
    if (!titles.length) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return; // CSS já mantém tudo visível

    titles.forEach(function (el) { el.classList.add('ee-anim-up'); });

    if (!('IntersectionObserver' in window)) {
      titles.forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
    titles.forEach(function (el) { io.observe(el); });
  })();


});
</script>

<!-- LP MAE: barra de proposta e scripts de planos/proposta removidos junto das secoes de oferta -->

</body>
</html>
