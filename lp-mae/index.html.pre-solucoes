<section id="reconhecimento" class="ee-recognition" aria-label="Reconhecimentos de plataformas">
  <div class="ee-recognition__inner">
    <h2 class="ee-recognition__title">Reconhecida pelas <strong>maiores plataformas</strong> de mídia.</h2>
