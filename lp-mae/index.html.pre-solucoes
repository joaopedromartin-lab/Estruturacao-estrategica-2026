<!-- FONTS: IBM Plex Sans via Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

<!-- Fjalla One self-hosted (mesma pasta de fontes; LP funciona offline) -->
<style id="fjalla-self-hosted">
/* Fjalla One — display da página (substituiu a Morganite).
   A Fjalla tem um só peso (400); os títulos que pediam 700 continuam
   declarando 700 e o browser resolve pro peso disponível, sem sintetizar
   negrito falso. Self-hosted pra LP funcionar offline, como era antes. */
@font-face {
  font-family: 'Fjalla One';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('assets/fonts/FjallaOne-Regular.ttf') format('truetype');
}
</style>

<!-- DESIGN SYSTEM SHOWCASE STYLES (minimal, for section nav + spec tables only) -->
<style id="ds-showcase-styles">
/* === LOGO MARQUEE === */
@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
.ds-marquee {
  overflow: hidden;
  position: relative;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
}
.ds-marquee__track {
  display: flex;
  width: max-content;
  animation: marquee-scroll 30s linear infinite;
}
.ds-marquee:hover .ds-marquee__track {
  animation-play-state: paused;
}
.ds-marquee__logos {
  display: flex;
  align-items: center;
  gap: clamp(3rem, 5vw, 6rem);
  padding-right: clamp(3rem, 5vw, 6rem);
  flex-shrink: 0;
}
.ds-marquee__logos img {
  height: 36px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
  opacity: 0.7;
  transition: opacity 0.3s ease;
  flex-shrink: 0;
}
.ds-marquee:hover .ds-marquee__logos img {
  opacity: 1;
}

/* === BRAND GRADIENT BACKGROUNDS === */
:root {
  --ds-gradient-dark: linear-gradient(135deg, #560303 0%, #7A0A02 40%, #FB2E0A 100%);
  --ds-gradient-subtle: linear-gradient(160deg, #560303 0%, #8B1205 50%, #C41E08 100%);
  --ds-gradient-radial: radial-gradient(ellipse at 20% 80%, #FB2E0A 0%, #7A0A02 40%, #560303 100%);
  --ds-offwhite: #FAF9F7;
  /* Tokens de espaçamento vertical pra padronização entre seções */
  --ee-pad-y-default: clamp(48px, 7vh, 96px);
  /* Respiro vertical CONSISTENTE entre as seções de conteúdo (ajuste aqui pra mudar tudo) */
  --ee-section-y: 128px;
  --ee-pad-x: clamp(1.5rem, -0.556rem + 5.6716vw, 6.25rem);
  /* Largura máxima do conteúdo — reduzida pra centralizar melhor em telas compartilhadas */
  --ee-max-width: 1440px;

  /* ============================================================
     ESCALA TIPOGRÁFICA — um degrau por papel.
     Antes cada seção inventava o seu clamp (48/56/40 pro mesmo h2,
     19/20/24 pro mesmo sub). Aqui existe UM valor por papel; se
     precisar mudar o tamanho de todos os títulos, muda-se só aqui.
     Razão ~1.25 (terça maior) entre degraus.
     ============================================================ */
  /* Display Fjalla One — números e palavras gigantes. 3 degraus, não 5.
     Valores menores que na Morganite: a Fjalla é bem menos condensada
     (glifo ~2,1x mais largo), então o mesmo px ocuparia muito mais linha. */
  --ee-display-xl: clamp(64px, 8.4vw, 158px);  /* missão (o maior momento da página) */
  --ee-display-lg: clamp(48px, 6.3vw, 114px);  /* hero, autoridade, ecossistema */
  --ee-display-md: clamp(40px, 4.8vw, 84px);   /* método, big numbers */
  /* Títulos de seção IBM Plex */
  --ee-title: clamp(28px, 3.2vw, 52px);        /* h2 padrão de todas as seções */
  --ee-title-sm: clamp(24px, 2.6vw, 40px);     /* h2 secundário (reconhecimento) */
  /* Texto */
  --ee-sub: clamp(16px, 1.4vw, 22px);          /* lead/subtítulo de seção */
  --ee-body: clamp(15px, 1.2vw, 18px);         /* corpo */
  --ee-body-sm: clamp(13px, 1.05vw, 16px);     /* corpo pequeno / apoio */
  --ee-label: clamp(11px, 0.95vw, 13px);       /* labels uppercase / meta */

  /* Alturas de linha por papel — display aperta, texto respira.
     Fjalla tem ascendente alta (2066/2048): 0.86 cortaria o topo das
     maiúsculas em títulos de 2 linhas, então sobe pra 0.95. */
  --ee-lh-display: 0.95;
  --ee-lh-title: 1.12;
  --ee-lh-body: 1.55;
  /* Tracking: a Fjalla já é mais aberta que a Morganite; sem negativo extra */
  --ee-ls-display: 0;
  --ee-ls-title: -0.02em;

  /* Raios — 3 degraus por elevação, em vez de 8 valores soltos */
  --ee-radius-sm: 14px;   /* chips, pills, elementos pequenos */
  --ee-radius-md: 20px;   /* cards e superfícies */
  --ee-radius-lg: 28px;   /* superfícies grandes / destaque */
  --ee-radius-pill: 9999px;

  /* Degraus de espaçamento interno (múltiplos de 4) */
  --ee-gap-sm: clamp(10px, 1vw, 16px);
  --ee-gap-md: clamp(16px, 1.8vw, 28px);
  --ee-gap-lg: clamp(28px, 3.2vw, 48px);
  --ee-gap-xl: clamp(44px, 5.5vw, 80px);
}
.ds-bg-gradient {
  background: var(--ds-gradient-dark) !important;
}
.ds-bg-gradient-subtle {
  background: var(--ds-gradient-subtle) !important;
}
.ds-bg-gradient-radial {
  background: var(--ds-gradient-radial) !important;
}
.ds-bg-offwhite {
  background-color: var(--ds-offwhite) !important;
}
/* Gradient sections: force light text + borders */
.ds-bg-gradient h1, .ds-bg-gradient h2, .ds-bg-gradient h3,
.ds-bg-gradient h4, .ds-bg-gradient h5, .ds-bg-gradient h6,
.ds-bg-gradient-subtle h1, .ds-bg-gradient-subtle h2, .ds-bg-gradient-subtle h3,
.ds-bg-gradient-subtle h4, .ds-bg-gradient-subtle h5, .ds-bg-gradient-subtle h6,
.ds-bg-gradient-radial h1, .ds-bg-gradient-radial h2, .ds-bg-gradient-radial h3,
.ds-bg-gradient-radial h4, .ds-bg-gradient-radial h5, .ds-bg-gradient-radial h6 {
  color: #FFFFFF !important;
}
.ds-bg-gradient p, .ds-bg-gradient .ds-section-label,
.ds-bg-gradient .ds-type-name, .ds-bg-gradient .ds-type-spec,
.ds-bg-gradient-subtle p, .ds-bg-gradient-subtle .ds-section-label,
.ds-bg-gradient-subtle .ds-type-name, .ds-bg-gradient-subtle .ds-type-spec,
.ds-bg-gradient-radial p, .ds-bg-gradient-radial .ds-section-label,
.ds-bg-gradient-radial .ds-type-name, .ds-bg-gradient-radial .ds-type-spec {
  color: rgba(255,255,255,0.75) !important;
}
.ds-bg-gradient .ds-type-row,
.ds-bg-gradient-subtle .ds-type-row,
.ds-bg-gradient-radial .ds-type-row {
  border-bottom-color: rgba(255,255,255,0.12) !important;
}
</style>

<!-- ============================================================ -->
<!-- ESTRUTURAÇÃO ESTRATÉGICA — ESTILOS DA PÁGINA                 -->
<!-- ============================================================ -->
<style id="ee-page-styles">
/* === RESPONSIVIDADE GERAL — COMPORTAMENTO DE SLIDE ===
   Cada seção é EXATAMENTE 1 viewport (um slide). O conteúdo "in-flow" é envolvido
   por .ee-slide__fit e escalado via JS (transform: scale) pra caber sem passar nem
   sobrar — exatamente como um slide se adapta a qualquer tela.
   Fundos absolutos (imagens full-bleed: mission/product) NÃO são escalados: ficam
   no lugar e cobrem a seção. Limitado a >=901px; no mobile mantém o fluxo natural. */
@media (min-width: 901px) {
  /* === FLUXO NATURAL — cada seção do tamanho do seu conteúdo; respiro vertical ÚNICO entre TODAS.
     Controle central: --ee-section-y (0 = coladas; qualquer valor = mesmo respiro em todas). === */
  #top > section {
    padding-top: var(--ee-section-y);
    padding-bottom: var(--ee-section-y);
  }
  /* Hero: tela cheia (intro), com respiro próprio */
  #top > #hero { padding-top: var(--ee-pad-y-default); padding-bottom: var(--ee-pad-y-default); }
  /* Missão: única seção de tela cheia que restou — o momento de maior peso da página */
  #top > #missao { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
  /* Ecossistema: imagem full-bleed de tela cheia, colada (sem respiro) */
  #top > #ecossistema { padding-top: 0; padding-bottom: 0; }
  #ecossistema .ee-ecosystem__img {
    width: 100%; height: 100vh; object-fit: contain; margin: 0; clip-path: none;
  }
  /* Cases: cards full-bleed 50/50 colados, sem respiro vertical e sem padding lateral */
  #top > #cases { padding-top: 0; padding-bottom: 0; padding-left: 0; padding-right: 0; }
  #top > #cases .ee-cases__heading { padding-left: var(--ee-pad-x); padding-right: var(--ee-pad-x); }
  /* Reconhecimento + clientes formam um bloco só (prova social): meio respiro entre eles,
     pra não parecerem duas seções desconexas com o mesmo fundo branco. */
  #top > #reconhecimento { padding-bottom: calc(var(--ee-section-y) / 2); }
  #top > #clientes { padding-top: calc(var(--ee-section-y) / 2); }
  /* Simulador fecha a página: respiro extra antes do footer */
  #top > #simulador { padding-bottom: calc(var(--ee-section-y) * 1.15); }
}

/* === HERO === */
.ee-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: stretch;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
  overflow: hidden;
  /* Fundo gradiente da marca — visível no estado de seleção (antes da imagem entrar) */
  background: radial-gradient(125% 120% at 50% 24%, #8B1004 0%, #4A0202 44%, #1a0000 100%);
}
/* Wipe "minhoca" (mantido): cobre de baixo→topo e encolhe pro topo na transição. */
.ee-hero__wipe {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100%;
  z-index: 6;
  background: #120000;
  transform: scaleY(0);
  transform-origin: 50% 100%;
  visibility: hidden;
  pointer-events: none;
}
/* SELECT: prompt + seletor centralizados sobre o gradiente (inalterado) */
.ee-hero__inner {
  width: 100%;
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}
.ee-hero__content {
  display: flex;
  flex-direction: column;
  gap: clamp(28px, 4vw, 48px);
}
.ee-hero .ee-model-selector {
  opacity: 0;
  transform: translateY(24px);
  will-change: opacity, transform;
}
.ee-hero__select-prompt {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(18px, 1.6vw, 26px);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: -0.01em;
  margin: 0;
  opacity: 0;
  transform: translateY(24px);
  will-change: opacity, transform;
}
.ee-hero__select-prompt strong { font-weight: 700; color: #FFFFFF; }

.ee-hero[data-hero-state="select"] { min-height: 100vh; }
.ee-hero[data-hero-state="select"] .ee-hero__inner {
  justify-content: center;
  align-items: center;
}
.ee-hero[data-hero-state="select"] .ee-hero__content {
  align-items: center;
  text-align: center;
}

/* === ESTADO WELCOME — split-screen: painel branco (esquerda) + imagem full-height (direita) === */
.ee-hero__welcome {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: none;
  grid-template-columns: 1.05fr 1fr;
}
.ee-hero[data-hero-state="welcome"] .ee-hero__welcome { display: grid; }
.ee-hero[data-hero-state="welcome"] .ee-hero__inner { display: none; }
.ee-hero__panel {
  position: relative;
  background: #FFFFFF;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(56px, 7vw, 120px) clamp(36px, 4.5vw, 88px);
}
.ee-hero__photo {
  position: relative;
  overflow: hidden;
  background: #C1130B;
}
.ee-hero__photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
/* Anotações nos cantos do painel branco */
.ee-hero__note {
  position: absolute;
  margin: 0;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(13px, 1vw, 17px);
  font-weight: 600;
  letter-spacing: -0.01em;
  /* gradiente escuro → vermelho em TODO o texto da anotação */
  background: linear-gradient(90deg, #280000 0%, #7A0A02 52%, #FB2E0A 100%);
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.ee-hero__note strong { font-weight: 700; }
.ee-hero__note em { font-style: italic; font-weight: 600; }
.ee-hero__note--tl { top: clamp(26px, 3.6vw, 52px); left: clamp(36px, 4.5vw, 88px); }
.ee-hero__note--tr { top: clamp(26px, 3.6vw, 52px); right: clamp(28px, 3.4vw, 64px); }
.ee-hero__note--bl { bottom: clamp(26px, 3.6vw, 52px); left: clamp(36px, 4.5vw, 88px); }
.ee-hero__note--br { bottom: clamp(26px, 3.6vw, 52px); right: clamp(28px, 3.4vw, 64px); }
/* Bloco de boas-vindas */
.ee-hero__welcome-lead {
  display: block;
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 300;            /* light */
  font-size: clamp(26px, 3.2vw, 54px);
  color: #280000;
  letter-spacing: -0.015em;
  line-height: 1;
  margin: 0 0 clamp(0px, 0.2vw, 4px);
}
.ee-hero__welcome-title {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;            /* Bold = peso mais forte disponível (não há Black self-hosted) */
  text-transform: uppercase;
  font-size: var(--ee-display-lg);
  line-height: 1;              /* caixa alta o suficiente p/ o gradiente (background-clip:text) cobrir o topo das maiúsculas */
  letter-spacing: var(--ee-ls-display);
  margin: -0.08em 0 0;         /* puxa pra cima → menos gap com o "Bem-Vindo à" (sem encostar) */
  padding: 0.12em 0 0.04em;    /* respiro do topo (gradiente cobre as maiúsculas → não corta) */
  /* gradiente escuro (esquerda) → vermelho (direita), como na referência */
  background: linear-gradient(90deg, #160000 0%, #280000 24%, #9A1004 62%, #FB2E0A 100%);
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
/* Seletor de modelo no painel welcome (abaixo do "V4 Company"): sempre visível
   — não entra na animação de entrada do seletor do estado select — + espaçamento */
.ee-hero__panel .ee-model-selector {
  opacity: 1;
  transform: none;
  margin-top: clamp(22px, 3vh, 40px);
}
/* Mobile: empilha painel em cima, imagem embaixo */
@media (max-width: 860px) {
  .ee-hero__welcome { grid-template-columns: 1fr; grid-template-rows: auto 42vh; }
}
@media (prefers-reduced-motion: reduce) {
  .ee-hero .ee-model-selector,
  .ee-hero__select-prompt { opacity: 1; transform: none; }
}

/* Trava de scroll enquanto nenhum modelo de vendas foi escolhido */
html.ee-scroll-lock,
html.ee-scroll-lock body {
  overflow: hidden;
}

/* === SALES MODEL SELECTOR === */
.ee-model-selector {
  position: relative;
  width: fit-content;
  max-width: 100%;
}
.ee-model-selector__trigger {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  min-width: clamp(320px, 36vw, 460px);
  padding: 22px 32px;
  background: linear-gradient(135deg, rgba(94, 5, 5, 0.82) 0%, rgba(139, 14, 5, 0.82) 50%, rgba(196, 30, 8, 0.82) 100%);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: var(--ee-radius-pill);
  color: #FFFFFF;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(15px, 1.2vw, 18px);
  font-weight: 500;
  letter-spacing: 0.02em;
  cursor: pointer;
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.15),
    0 0 28px rgba(251, 46, 10, 0.22);
  transition:
    background 0.3s cubic-bezier(0.23, 1, 0.32, 1),
    box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1),
    transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}
.ee-model-selector__trigger:hover {
  box-shadow:
    0 12px 36px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 0 40px rgba(255, 98, 0, 0.35);
  transform: translateY(-1px);
}
.ee-model-selector__trigger:active { transform: translateY(0); }
.ee-model-selector__trigger:focus-visible {
  outline: 2px solid rgba(255, 255, 255, 0.6);
  outline-offset: 3px;
}
.ee-model-selector__label {
  flex: 1;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ee-model-selector__chevron {
  flex-shrink: 0;
  transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
}
.ee-model-selector[data-state="open"] .ee-model-selector__chevron {
  transform: rotate(180deg);
}
.ee-model-selector__menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  right: 0;
  margin: 0;
  padding: 8px;
  list-style: none;
  background: rgba(30, 5, 5, 0.94);
  -webkit-backdrop-filter: blur(18px) saturate(180%);
  backdrop-filter: blur(18px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--ee-radius-md);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
  opacity: 0;
  transform: translateY(-8px);
  pointer-events: none;
  transition:
    opacity 0.25s cubic-bezier(0.23, 1, 0.32, 1),
    transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  z-index: 20;
}
.ee-model-selector[data-state="open"] .ee-model-selector__menu {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.ee-model-selector__menu li {
  padding: 14px 26px;
  border-radius: var(--ee-radius-pill);
  color: rgba(255, 255, 255, 0.88);
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(15px, 1.2vw, 18px);
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
  user-select: none;
}
.ee-model-selector__menu li + li { margin-top: 2px; }
.ee-model-selector__menu li:hover,
.ee-model-selector__menu li:focus-visible {
  background: rgba(255, 98, 0, 0.18);
  color: #FFFFFF;
  outline: none;
}
.ee-model-selector__menu li.is-selected {
  background: rgba(251, 46, 10, 0.28);
  color: #FFFFFF;
}

/* Sections that depend on a sales model selection start hidden */
[data-depends-on-sales-model] { display: none; }
body[data-sales-model] [data-depends-on-sales-model] { display: revert; }

/* === SEÇÃO AUTORIDADE === */
.ee-auth {
  background: #FFFFFF;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
}
.ee-auth__inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 5vw, 80px);   /* coluna: texto | mapa */
  row-gap: clamp(8px, 1.4vh, 22px);  /* linha menor: aproxima a faixa de big numbers do conteúdo */
  align-items: center;
}
@media (min-width: 960px) {
  .ee-auth__inner {
    grid-template-columns: 1fr 1fr; /* conteúdo | mapa */
  }
}
/* Coluna de conteúdo (esquerda) */
.ee-auth__main {
  display: flex;
  flex-direction: column;
  gap: clamp(18px, 2.4vh, 36px);
}
.ee-auth__eyebrow {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  font-size: var(--ee-body);
  color: #606060;
  margin: 0;
  letter-spacing: -0.005em;
}
/* Divisor + selos: imagem única (divisornumber.png) que você passou */
.ee-auth__divider-img {
  display: block;
  width: 100%;
  height: auto;
}
/* Mapa (direita) */
.ee-auth__map { display: flex; justify-content: center; }
.ee-auth__map-img {
  display: block;
  width: 100%;
  height: auto;
  max-width: 480px;
}

/* Big numbers em uma única linha (4 colunas) no rodapé do conteúdo */
.ee-auth__stats {
  grid-column: 1 / -1;              /* faixa full-width abaixo da head + mapa */
  display: flex;
  flex-wrap: wrap;
  gap: 0;                          /* o respiro vem do padding + divisor */
  align-items: stretch;
  margin-top: 0;
}
.ee-auth__stat {
  flex: 1 1 0;                     /* 4 colunas de largura igual ocupando a faixa toda */
  min-width: 160px;               /* abaixo disso, quebra em 2 por linha (mobile) */
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(6px, 1vw, 16px) clamp(20px, 2.4vw, 44px);
}
.ee-auth__stat:first-child { padding-left: 0; }
/* Divisor vertical entre os big numbers */
.ee-auth__stat + .ee-auth__stat {
  border-left: 1px solid rgba(40, 0, 0, 0.18);
}

.ee-auth__stat-number {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  font-size: var(--ee-display-md);
  line-height: var(--ee-lh-display);
  letter-spacing: var(--ee-ls-display);
  color: #E50914;
  margin: 0 0 var(--ee-gap-sm);
  text-transform: uppercase;
  font-variant-numeric: tabular-nums; /* dígitos com largura igual = sem "pulinho" durante count-up */
}
/* Estado inicial antes da animação dispara — evita flash do número final */
.ee-auth__stat-number[data-counting="pending"] { opacity: 0; }
.ee-auth__stat-label {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  font-size: var(--ee-body);
  line-height: 1.4;
  color: #280000;
  margin: 0;
  letter-spacing: -0.005em;
}

.ee-auth__who-title {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  font-size: var(--ee-display-lg);
  line-height: var(--ee-lh-display);
  letter-spacing: var(--ee-ls-display);
  text-transform: uppercase;
  margin: 0;
  background: linear-gradient(160deg, #560303 0%, #8B1205 50%, #C41E08 100%);
  -webkit-background-clip: text;
          background-clip: text;
  color: transparent;
}
.ee-auth__who-title span { display: block; }
.ee-auth__who-sub {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  font-size: clamp(20px, 1.8vw, 32px);
  line-height: 1.35;
  color: #280000;
  margin: clamp(-28px, -2vw, -12px) 0 0;
  letter-spacing: -0.01em;
}
.ee-auth__who-sub strong { font-weight: 700; }

/* Stack no mobile: divisores adaptados */
@media (max-width: 600px) {
  .ee-auth__stat-number { font-size: clamp(56px, 18vw, 88px); }
}

/* === SEÇÃO RECONHECIMENTO (texto esquerda + badges empilhados direita) === */
.ee-recognition {
  background: #FFFFFF;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
  /* Aproxima da seção "Quem acredita na V4" logo abaixo (mesmo bloco de prova social) */
  padding-bottom: var(--ee-gap-xl);
}
.ee-recognition__inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 5vw, 80px);
  align-items: center;
}
@media (min-width: 760px) {
  .ee-recognition__inner {
    grid-template-columns: 1fr 1fr;
  }
}
.ee-recognition__title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-title-sm);
  font-weight: 400;
  color: #280000;
  margin: 0;
  letter-spacing: var(--ee-ls-title);
  line-height: var(--ee-lh-title);
  max-width: 22ch;
}
.ee-recognition__title strong {
  font-weight: 700;
  background: linear-gradient(90deg, #E50914 0%, #FF3D47 45%, #280000 100%);
  -webkit-background-clip: text;
          background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}
/* Grade de badges: 2 colunas escalonadas (a 2ª desce um pouco), igual ao layout
   de referência. Cards (Kommo/HubSpot/Google/Meta) + selos hexagonais (Tray/Facebook). */
.ee-recognition__badges {
  width: 100%;
  max-width: 540px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(14px, 1.8vw, 28px);
  align-items: start;
  justify-items: center;
}
.ee-recognition__col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(22px, 2.6vw, 40px);
  width: 100%;
}
/* Escalona a 2ª coluna pra baixo (efeito masonry da referência) */
.ee-recognition__col--offset {
  margin-top: clamp(26px, 4vw, 56px);
}
.ee-recognition__badge {
  width: 100%;
  max-width: 200px;
  height: auto;
  display: block;
  filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.14));
  transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
              filter    0.4s cubic-bezier(0.23, 1, 0.32, 1);
}
/* Selos hexagonais (sem moldura de card) — um pouco menores pra harmonizar */
.ee-recognition__badge--hex {
  max-width: 128px;
  filter: drop-shadow(0 12px 26px rgba(0, 0, 0, 0.16));
}
.ee-recognition__badge:hover {
  transform: translateY(-5px) scale(1.03);
  filter: drop-shadow(0 18px 42px rgba(0, 0, 0, 0.24));
}
@media (max-width: 480px) {
  .ee-recognition__badge { max-width: 168px; }
  .ee-recognition__badge--hex { max-width: 112px; }
}

/* === SEÇÃO CLIENTES (marquee de logos, 2 linhas, direções opostas) === */
.ee-clients {
  background: #FFFFFF;
  padding: var(--ee-pad-y-default) 0;
  /* Aproxima da seção de reconhecimento (badges) logo acima */
  padding-top: var(--ee-gap-xl);
  overflow: hidden;
}
.ee-clients__title {
  text-align: center;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-title);
  font-weight: 400;
  color: #280000;
  margin: 0 0 var(--ee-gap-xl);
  padding: 0 var(--ee-pad-x);
  letter-spacing: var(--ee-ls-title);
  line-height: var(--ee-lh-title);
}
.ee-clients__title strong { font-weight: 700; color: #E50914; }
.ee-clients__rows {
  display: flex;
  flex-direction: column;
  gap: clamp(20px, 2.6vh, 36px);
}
/* Velocidades ligeiramente diferentes pra dar sensação orgânica
   (24 logos por linha → durações longas pra movimento ficar suave).
   animation-delay NEGATIVO faz a track começar "já avançada" (no meio do ciclo),
   evitando começar com o primeiro logo grudado na borda esquerda. */
.ee-clients__row .ds-marquee__track {
  animation-duration: 110s;
  animation-delay: -55s; /* metade de 110s → começa no centro do ciclo */
}
.ee-clients__row--reverse .ds-marquee__track {
  animation-duration: 130s;
  animation-direction: reverse; /* keyframe marquee-scroll vai 0 → -50%; reverse inverte para mover à direita */
  animation-delay: -80s; /* offset diferente da linha 2 → desalinha os logos entre as duas linhas */
}
/* Item de logo (img) — SLOT FIXO pra consistência (cada logo ocupa o mesmo espaço,
   independente do aspect ratio original) */
.ee-clients__logo {
  flex-shrink: 0;
  display: block;
  width: clamp(120px, 12vw, 170px);
  height: clamp(40px, 3.8vw, 56px);
  object-fit: contain;
  object-position: center;
  /* Default: fundo branco da seção #clientes → tudo preto fade */
  filter: brightness(0);
  opacity: 0.5;
  transition: opacity 0.3s ease;
}
.ee-clients__logo:hover { opacity: 0.85; }

/* Army BR e Bombeef — logos menores por natureza, precisam de slot maior pra ficar consistentes visualmente */
.ee-clients__logo[src*="army br"],
.ee-clients__logo[src*="bombeef"] {
  width: clamp(160px, 16vw, 220px);
  height: clamp(60px, 5.6vw, 80px);
}

/* === MARQUEE SEAMLESS LOOP ===
   Override do keyframe original do brandbook (que vai 0 → -100% e tem "pulinho").
   Como nossos tracks têm 2 cópias idênticas dos logos lado a lado, mover só -50%
   coloca a segunda cópia exatamente onde a primeira estava → reset invisível. */
@keyframes ee-marquee-seamless {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.ee-clients__row .ds-marquee__track {
  animation-name: ee-marquee-seamless;
}

/* === FAIXA DE AFILIAÇÃO (Grupo Dreamers + InfoMoney) ===
   Vive DENTRO da seção "Quem acredita na V4" (#clientes), abaixo das 2 faixas de logo.
   Sem fundo próprio (herda o branco da seção); só um gap das faixas acima. */
.ee-affiliation {
  margin-top: clamp(56px, 8vh, 110px);
  padding: 0 var(--ee-pad-x); /* #clientes tem padding lateral 0 (marquees full-bleed) */
}
.ee-affiliation__inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(20px, 3vh, 40px);
  text-align: center;
}
.ee-affiliation__text {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(16px, 1.6vw, 24px);
  font-weight: 400;
  color: #280000;
  margin: 0;
  letter-spacing: -0.01em;
}
.ee-affiliation__text strong { font-weight: 700; }
.ee-affiliation__logos {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: clamp(32px, 6vw, 96px);
}
.ee-affiliation__logo {
  height: clamp(34px, 3.6vw, 52px);
  width: auto;
  display: block;
  /* Os SVGs originais são brancos (sumiam no fundo claro). Recolorimos pra escuro
     via filtro — mesma técnica das logos de clientes acima (brightness(0)). */
  filter: brightness(0);
  opacity: 0.72;
}
/* O globo do Rock in Rio é mais "alto" que os logos de texto — equilibra visualmente */
.ee-affiliation__logo--rockinrio { height: clamp(46px, 4.8vw, 68px); }

/* === SEÇÃO CASES (fundo branco — card por modelo de vendas) === */
.ee-cases {
  background: #FFFFFF;
  color: #280000;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
  position: relative;
  overflow: hidden;
}
.ee-cases__inner {
  max-width: none;
  margin: 0;
}
.ee-cases__heading {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-title);
  font-weight: 400;
  color: #280000;
  margin: 0 0 var(--ee-gap-xl);
  letter-spacing: var(--ee-ls-title);
  line-height: var(--ee-lh-title);
  text-align: center;
}
.ee-cases__heading strong { font-weight: 700; color: #E50914; }

/* Estado vazio (sem modelo selecionado) */
.ee-cases__empty {
  text-align: center;
  padding: clamp(48px, 7vw, 90px);
  border: 1px dashed rgba(40, 0, 0, 0.2);
  border-radius: var(--ee-radius-md);
  color: rgba(40, 0, 0, 0.6);
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(15px, 1.2vw, 19px);
  line-height: 1.45;
  letter-spacing: -0.005em;
}
.ee-cases__empty strong { color: #E50914; font-weight: 700; }
.ee-cases[data-state="filled"] .ee-cases__empty { display: none; }
.ee-cases[data-state="empty"]  .ee-cases__group { display: none; }

/* Grupos por modelo — só o ativo aparece; 2 cards lado a lado, SEM gap */
.ee-cases__group { display: none; }
.ee-cases__group.is-active {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  overflow: hidden;
}
@media (max-width: 720px) {
  .ee-cases__group.is-active { grid-template-columns: 1fr; }
}
/* Card: imagem full-bleed + overlay preto suave; conteúdo ancorado embaixo */
.ee-cases__card {
  position: relative;
  min-height: clamp(460px, 72vh, 740px);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  background-color: #2A0101;
  background-size: cover;
  background-position: center;
  isolation: isolate;
}
.ee-cases__card--ph {
  background-image: linear-gradient(160deg, #C41E08 0%, #7A0A02 55%, #2A0101 100%);
}
.ee-cases__card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.66) 45%, rgba(0,0,0,0.46) 100%);
}
/* Tint uniforme: card começa "meio escuro" e ACENDE no hover (o tint some) */
.ee-cases__card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(0, 0, 0, 0.52);
  transition: opacity 0.45s ease;
  pointer-events: none;
}
.ee-cases__card:hover::after { opacity: 0; }
@media (prefers-reduced-motion: reduce) {
  .ee-cases__card::after { transition: none; }
}
.ee-cases__card-body {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: clamp(24px, 2.6vw, 44px) clamp(24px, 2.6vw, 44px) clamp(48px, 6vw, 104px);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: clamp(12px, 1.4vh, 18px);
}
.ee-cases__brand {
  display: flex;
  align-items: center;
  gap: clamp(12px, 1.2vw, 16px);
}
.ee-cases__logo {
  flex-shrink: 0;
  width: clamp(48px, 3.8vw, 62px);
  height: clamp(48px, 3.8vw, 62px);
  border-radius: 50%;
  background: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 700;
  font-size: clamp(13px, 1.1vw, 17px);
  color: #280000;
  overflow: hidden;
  letter-spacing: 0.02em;
}
/* logo inteira dentro do badge (sem cortar) */
.ee-cases__logo img { width: 78%; height: 78%; object-fit: contain; }
.ee-cases__name {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 700;
  font-size: clamp(20px, 2vw, 30px);
  color: #FFFFFF;
  letter-spacing: -0.015em;
  line-height: 1.1;
}
.ee-cases__brand-text { display: flex; flex-direction: column; gap: 2px; }
.ee-cases__type {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(10px, 0.9vw, 13px);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.6);
}
.ee-cases__challenge {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-body-sm);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.82);
  margin: 0;
  line-height: 1.45;
  max-width: 480px;
  letter-spacing: -0.005em;
}
.ee-cases__nums {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: clamp(12px, 1.6vh, 18px) clamp(20px, 2.4vw, 38px);
  margin-top: clamp(4px, 1vh, 10px);
}
.ee-cases__num { display: flex; flex-direction: column; gap: 4px; }
.ee-cases__num-label {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-label);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.62);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.ee-cases__num-val {
  font-family: 'IBM Plex Sans', sans-serif;
  line-height: 1;
  white-space: nowrap;
  display: inline-flex;
  align-items: baseline;
}
/* antes (apagado / menor)  →  depois (destacado / maior) */
.ee-cases__num-before {
  font-size: clamp(13px, 1.2vw, 17px);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.42);
  letter-spacing: -0.01em;
}
.ee-cases__num-before::after {
  content: "→";
  margin: 0 0.42em;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
}
.ee-cases__num-after {
  font-size: clamp(20px, 2vw, 30px);
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -0.02em;
}
/* herói — o big number em destaque (linha inteira, bem maior) */
.ee-cases__num--hero { flex-basis: 100%; gap: 5px; }
.ee-cases__num--hero .ee-cases__num-after { font-size: clamp(34px, 4.2vw, 60px); }
.ee-cases__num--hero .ee-cases__num-before { font-size: clamp(16px, 1.7vw, 24px); }
.ee-cases__num-note {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-label);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0;
}
.ee-cases__quote {
  font-family: 'IBM Plex Sans', sans-serif;
  font-style: italic;
  font-weight: 500;
  font-size: var(--ee-body-sm);
  color: rgba(255, 255, 255, 0.92);
  margin: clamp(6px, 1.2vh, 12px) 0 0;
  line-height: 1.4;
  max-width: 480px;
  padding-left: 13px;
  border-left: 3px solid #FB2E0A;
}

/* Slider de cases dentro de cada grupo */
.ee-cases__slider {
  display: grid;
  position: relative;
  isolation: isolate;
}
.ee-cases__slide {
  grid-area: 1 / 1;
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(28px, 4vw, 72px);
  align-items: center;
  opacity: 0;
  transform: translateY(10px);
  pointer-events: none;
  visibility: hidden;
  z-index: 1;
  transition:
    opacity   0.45s cubic-bezier(0.23, 1, 0.32, 1),
    transform 0.45s cubic-bezier(0.23, 1, 0.32, 1),
    visibility 0s linear 0.45s;
}
@media (min-width: 900px) {
  .ee-cases__slide { grid-template-columns: 0.9fr 1fr; } /* imagem | conteúdo */
}
.ee-cases__slide.is-active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
  visibility: visible;
  z-index: 2;
  transition:
    opacity   0.45s cubic-bezier(0.23, 1, 0.32, 1),
    transform 0.45s cubic-bezier(0.23, 1, 0.32, 1),
    visibility 0s linear 0s;
}
.ee-cases__content { display: flex; flex-direction: column; }
.ee-cases__title {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  font-size: clamp(36px, 4.5vw, 72px);
  line-height: 0.88;
  text-transform: uppercase;
  letter-spacing: 0;
  color: #FFFFFF;
  margin: 0 0 clamp(20px, 2.4vw, 36px);
}
/* Eyebrow "CASES" — pequeno texto identificando a seção */
.ee-cases__eyebrow {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  font-size: clamp(24px, 2.8vw, 44px);
  text-transform: uppercase;
  letter-spacing: 0;
  line-height: 1;
  color: #FFFFFF;
  margin: 0 0 clamp(20px, 2.5vw, 36px);
}
.ee-cases__brand-name {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 700;
  font-size: clamp(24px, 2.6vw, 40px);
  color: #280000;
  margin: 0;
  letter-spacing: -0.02em;
  line-height: 1.1;
}
.ee-cases__brand-type {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  font-size: clamp(14px, 1.1vw, 18px);
  color: #707070;
  margin: 6px 0 0;
  letter-spacing: -0.005em;
}
/* Descrição do case (parágrafo abaixo do brand) */
.ee-cases__brand-desc {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(15px, 1.2vw, 19px);
  font-weight: 400;
  color: #444444;
  margin: clamp(16px, 2vw, 28px) 0 0;
  line-height: 1.5;
  letter-spacing: -0.005em;
  max-width: 520px;
}
/* Nota auxiliar abaixo das métricas (ex: "Cadência de follow-up ativa.") */
.ee-cases__metric-note {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(14px, 1.1vw, 17px);
  font-weight: 400;
  color: #606060;
  margin: clamp(16px, 2vh, 24px) 0 0;
  line-height: 1.4;
  letter-spacing: -0.005em;
}

/* Mídia do case — imagem grande arredondada (coluna esquerda) */
.ee-cases__media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--ee-radius-lg);
  overflow: hidden;
  background: linear-gradient(180deg, #FF3B0F 0%, #C41E08 45%, #3A0000 100%);
}
.ee-cases__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ee-cases__media-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-body-sm);
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  padding: 24px;
  letter-spacing: -0.005em;
}

/* Resultados (data points) — antes → depois, em linha */
.ee-cases__metrics {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(28px, 4vw, 64px);
  margin-top: clamp(28px, 4vh, 56px);
}
.ee-cases__metric-label {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-body-sm);
  font-weight: 400;
  color: #909090;
  margin: 0 0 8px;
  letter-spacing: 0.01em;
}
.ee-cases__metric-values {
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.ee-cases__metric-before {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(18px, 1.8vw, 26px);
  font-weight: 400;
  color: #B5B5B5;
  letter-spacing: -0.02em;
  line-height: 1;
}
.ee-cases__metric-before::after {
  content: "→";
  margin-left: 10px;
  color: #C8C8C8;
}
.ee-cases__metric-after {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(34px, 4vw, 60px);
  font-weight: 700;
  color: #E50914;
  letter-spacing: -0.025em;
  line-height: 1;
}

/* Navegação ← → entre slides do grupo */
.ee-cases__nav {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  margin-top: clamp(40px, 5vh, 72px);
  position: relative;
  z-index: 3;
}
.ee-cases__nav-btn {
  width: 48px;
  height: 48px;
  border: 1px solid rgba(40, 0, 0, 0.25);
  border-radius: 50%;
  background: transparent;
  color: #280000;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.25s cubic-bezier(0.23, 1, 0.32, 1),
    border-color 0.25s cubic-bezier(0.23, 1, 0.32, 1),
    color 0.25s,
    transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}
.ee-cases__nav-btn:hover {
  background: rgba(229, 9, 20, 0.06);
  border-color: rgba(229, 9, 20, 0.5);
  color: #E50914;
  transform: translateY(-1px);
}
.ee-cases__nav-btn:focus-visible {
  outline: 2px solid rgba(229, 9, 20, 0.5);
  outline-offset: 3px;
}
.ee-cases__nav-btn svg { width: 18px; height: 18px; stroke-width: 2.2; }
.ee-cases__nav-dots {
  display: inline-flex;
  gap: 6px;
  margin: 0 16px;
}
.ee-cases__nav-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(40, 0, 0, 0.2);
  transition: background 0.25s;
}
.ee-cases__nav-dot.is-active { background: #E50914; }

/* === SEÇÃO ECOSSISTEMA (full-bleed image only) === */
.ee-ecosystem {
  position: relative;
  display: block;
  /* O PNG dos 5 personagens tem fundo transparente, então este gradiente aparece
     atrás dele. Ele CONTINUA o radial da seção de Cases (mesma elipse/stops, só com
     o centro deslocado pra -10%, deixando o brilho laranja no topo, casando com o
     rodapé dos Cases) e TERMINA em #280000 (mesma cor do +30 soluções, logo abaixo). */
  background:
    radial-gradient(ellipse 130% 110% at 50% -10%,
      #FB2E0A 0%,
      #C41E08 28%,
      #7A0A02 52%,
      #3A0000 78%,
      #280000 100%
    );
  line-height: 0; /* remove qualquer gap em torno da img */
  font-size: 0;     /* mata whitespace inline residual */
  margin: 0;
  padding: 0;
}
.ee-ecosystem__img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 0 -1px 0; /* puxa 1px pra cima e cobre qualquer rounding do navegador */
  vertical-align: bottom; /* trava o baseline pra não criar gap */
  clip-path: inset(0 0 4px 0); /* corta 4px da borda inferior (faixa escura/transparente do PNG) */
}

/* Gradiente à FRENTE do PNG: apaga a parte de baixo dos personagens, mesclando-os
   com o fundo #280000 (mesma cor do +30 soluções). */
.ee-ecosystem__fade {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(180deg,
    transparent 0%,
    transparent 52%,
    rgba(40, 0, 0, 0.45) 74%,
    #280000 97%
  );
}

/* Texto sobreposto: "Ecossistema" (display) embaixo à esquerda + sub à direita */
.ee-ecosystem__overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding-bottom: clamp(36px, 6vh, 96px);
}
.ee-ecosystem__overlay-inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  padding: 0 var(--ee-pad-x);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: clamp(24px, 4vw, 80px);
}
.ee-ecosystem__title {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  font-size: var(--ee-display-lg);
  line-height: var(--ee-lh-display);
  letter-spacing: var(--ee-ls-display);
  color: #FFFFFF;
  margin: 0;
}
.ee-ecosystem__sub {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  font-size: var(--ee-sub);
  line-height: 1.4;
  letter-spacing: -0.01em;
  color: rgba(255, 255, 255, 0.92);
  text-align: right;
  max-width: 420px;
  margin: 0 0 clamp(8px, 1vh, 18px);
}
.ee-ecosystem__sub strong { font-weight: 700; color: #FFFFFF; }

@media (max-width: 760px) {
  .ee-ecosystem__overlay-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(8px, 2vw, 16px);
  }
  .ee-ecosystem__sub { text-align: left; max-width: 100%; }
}

/* === SEÇÃO ECOSSISTEMA-30 (+30 soluções digitais — texto + imagem) === */
.ee-ecosystem30 {
  position: relative;
  background: #280000;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
  overflow: hidden;
}
.ee-ecosystem30__inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 5vw, 80px);
  align-items: center;
}
@media (min-width: 960px) {
  .ee-ecosystem30__inner { grid-template-columns: 1fr 1fr; }
}
.ee-ecosystem30__content {
  display: flex;
  flex-direction: column;
  gap: clamp(12px, 1.4vw, 20px);
}
.ee-ecosystem30__number {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(96px, 13vw, 220px);
  font-weight: 700;
  color: #FFFFFF;
  line-height: 0.85;
  letter-spacing: -0.04em;
  margin: 0;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 55%, #FFB8AC 100%);
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
}
.ee-ecosystem30__title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-title);
  font-weight: 700;
  color: #FFFFFF;
  margin: var(--ee-gap-sm) 0 0;
  letter-spacing: var(--ee-ls-title);
  line-height: var(--ee-lh-title);
}
.ee-ecosystem30__title em {
  font-style: normal;
  color: #FB2E0A;
}
.ee-ecosystem30__body {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-body);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  margin: 0;
  line-height: var(--ee-lh-body);
  letter-spacing: -0.005em;
  max-width: 460px;
}
.ee-ecosystem30__body + .ee-ecosystem30__body {
  margin-top: clamp(8px, 1vh, 16px);
}
.ee-ecosystem30__media {
  display: flex;
  justify-content: center;
  align-items: center;
}
.ee-ecosystem30__img {
  display: block;
  width: 100%;
  height: auto;
  max-width: 720px;
}

/* === SEÇÃO MISSÃO (full-bleed bg + conteúdo esquerda) === */
.ee-mission {
  position: relative;
  width: 100%;
  min-height: clamp(480px, 68vh, 760px);
  display: flex;
  align-items: center;
  overflow: hidden;
  /* vermelho no meio (atrás do VENDER) escurecendo até a base, terminando na MESMA
     cor escura em que o método começa — sem pico de brilho na emenda (fluxo contínuo) */
  background: linear-gradient(180deg, #FF3D0A 0%, #F0200C 52%, #D2120A 100%);
}
.ee-mission__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: var(--ee-max-width);
  margin: 0 auto;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
}
.ee-mission__content {
  width: fit-content;
  max-width: 100%;
  margin-inline: auto;     /* centraliza o bloco (VENDER + pontos) na seção */
  color: #FFFFFF;
}
/* VENDER à esquerda + os 4 pontos à direita (ao lado), centralizados na vertical */
.ee-mission__row {
  display: flex;
  align-items: center;
  gap: clamp(40px, 6vw, 120px);
  flex-wrap: wrap;
}
.ee-mission__eyebrow {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(24px, 2vw, 36px);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.92);
  margin: 0 0 clamp(10px, 1.2vw, 20px);
  letter-spacing: -0.005em;
}
.ee-mission__eyebrow strong { font-weight: 700; }
.ee-mission__title {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  font-size: var(--ee-display-xl);
  line-height: var(--ee-lh-display);
  letter-spacing: var(--ee-ls-display);
  text-transform: uppercase;
  color: #FFFFFF;
  margin: 0;
  white-space: nowrap;    /* mantém "VENDER" em uma linha */
  flex: 0 0 auto;
}
.ee-mission__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: clamp(16px, 2vh, 32px);
  flex: 0 1 auto;         /* largura pelo conteúdo (pra centralizar o bloco); quebra no mobile */
}
.ee-mission__list li {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(20px, 1.8vw, 32px);
  color: #FFFFFF;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.1;
}
.ee-mission__num { font-weight: 700; }

/* Mobile: conteúdo ocupa tudo */
@media (max-width: 900px) {
  .ee-mission { min-height: auto; }
  .ee-mission__content { max-width: 100%; }
}

/* Estado inicial da animação GSAP — entram quando o GSAP rodar */
.ee-mission__eyebrow,
.ee-mission__list li {
  opacity: 0;
  transform: translateY(24px);
  will-change: opacity, transform;
}
.ee-mission__title {
  opacity: 0;
  transform: translateY(40px) scale(0.92);
  transform-origin: left center;
  will-change: opacity, transform;
}
@media (prefers-reduced-motion: reduce) {
  .ee-mission__eyebrow,
  .ee-mission__list li,
  .ee-mission__title {
    opacity: 1;
    transform: none;
  }
}

/* === SEÇÃO MÉTODO (header central + 4 cards didáticos) === */
.ee-method {
  background: #FFFFFF;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
}
.ee-method__inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: clamp(48px, 6vh, 88px);
}

/* Header em 2 colunas: headline (esquerda) + sub (direita) */
.ee-method__head {
  text-align: left;
  max-width: var(--ee-max-width);
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: clamp(28px, 5vw, 88px);
}
@media (max-width: 860px) {
  .ee-method__head { flex-direction: column; gap: clamp(16px, 3vh, 28px); }
}
.ee-method__title {
  font-family: 'Fjalla One', 'Oswald', 'Arial Narrow', sans-serif;
  font-weight: 700;
  font-size: var(--ee-display-md);
  line-height: var(--ee-lh-display);
  letter-spacing: var(--ee-ls-display);
  text-transform: uppercase;
  margin: 0;
  /* O acento de "MÉTODO" sobe acima da altura de caixa alta; com background-clip:text
     o recorte segue a caixa da linha, então sem esse respiro no topo o É perde o acento. */
  padding-top: 0.14em;
  /* gradiente geral no "MÉTODO V4" (escuro → vermelho), legível no fundo branco */
  background: linear-gradient(90deg, #280000 0%, #7A0A02 45%, #FB2E0A 100%);
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.ee-method__title strong { font-weight: 700; }
.ee-method__sub {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  font-size: var(--ee-sub);
  line-height: var(--ee-lh-body);
  color: rgba(40, 0, 0, 0.7);
  margin: 0;
  max-width: 760px;             /* sub mais esticada na coluna da direita */
  letter-spacing: -0.005em;
  flex: 0 1 760px;
}
@media (max-width: 860px) { .ee-method__sub { max-width: none; flex: 1 1 auto; } }
.ee-method__sub strong { color: #280000; font-weight: 700; }

/* Grid dos 4 pilares */
.ee-method__pillars {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 3vw, 56px);
}
@media (min-width: 680px)  { .ee-method__pillars { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1080px) { .ee-method__pillars { grid-template-columns: repeat(4, 1fr); } }

/* Pilar: ícone (acima) + card */
.ee-method__pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(14px, 1.4vw, 20px);
}
.ee-method__pillar-icon {
  display: block;
  width: clamp(44px, 3.6vw, 60px);
  height: auto;
}
.ee-method__pillar-card {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(22px, 2.6vh, 36px);
  padding: clamp(24px, 2.2vw, 38px) clamp(16px, 1.6vw, 26px);
  background: rgba(40, 0, 0, 0.025);
  border-radius: var(--ee-radius-md);
  position: relative;
}
/* Traçado em gradiente brand (borda via máscara, sem fundo) */
.ee-method__pillar-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1.5px;
  background: linear-gradient(160deg, #FB2E0A 0%, #C41E08 50%, #7A0A02 100%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
          mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;
  pointer-events: none;
}
.ee-method__pillar-title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(19px, 1.6vw, 26px);
  font-weight: 500;
  color: #280000;
  margin: 0;
  text-align: center;
  letter-spacing: -0.015em;
  line-height: 1.15;
}
/* Ferramentas — empilhadas, centralizadas */
.ee-method__pillar-tools {
  list-style: none;
  padding: 0;
  margin: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(20px, 2.4vh, 32px);
}
.ee-method__tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
}
.ee-method__tool img,
.ee-method__tool svg {
  display: block;
  width: clamp(34px, 3vw, 46px);
  height: clamp(34px, 3vw, 46px);
  object-fit: contain;
}
.ee-method__tool svg { color: #E50914; stroke-width: 1.75; }
.ee-method__tool-label {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-body-sm);
  font-weight: 500;
  color: rgba(40, 0, 0, 0.8);
  letter-spacing: -0.005em;
  line-height: 1.3;
}
/* Estado inicial pra animação GSAP em onda dos 4 pilares */
.ee-method__pillar {
  opacity: 0;
  transform: translateY(28px);
  will-change: opacity, transform;
}
@media (prefers-reduced-motion: reduce) {
  .ee-method__pillar { opacity: 1; transform: none; }
}


/* === SLIDE-UP REVEAL DOS TÍTULOS (IntersectionObserver) === */
.ee-anim-up {
  opacity: 0;
  transform: translateY(32px);
  transition:
    opacity 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.18s,
    transform 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.18s;
  will-change: opacity, transform;
}
.ee-anim-up.is-in {
  opacity: 1;
  transform: none;
}
@media (prefers-reduced-motion: reduce) {
  .ee-anim-up { opacity: 1; transform: none; transition: none; }
}

/* === GSAP CHARACTER REVEAL === */
/* Estado inicial dos chars antes do GSAP animar */
.ee-reveal-chars .char {
  display: inline-block;
  opacity: 0;
  transform: translateY(0.45em);
  will-change: opacity, transform;
}
/* Fallback caso o JS / Splitting falhem: sem .char gerado, mostra texto normal */
.ee-reveal-chars:not([data-splitted]) { opacity: 1; }
@media (prefers-reduced-motion: reduce) {
  .ee-reveal-chars .char { opacity: 1 !important; transform: none !important; }
}



/* === SEÇÃO — SIMULADOR DE PRODUTO (Saber → Ter → Executar → Performar) ===
   Fundo branco. 4 barras arrastáveis; tentar furar a ordem dispara um alerta. */
.ee-sim {
  background: #FFFFFF;
  color: #280000;
  padding: var(--ee-pad-y-default) var(--ee-pad-x);
}
.ee-sim__inner {
  max-width: var(--ee-max-width);
  margin: 0 auto;
  width: 100%;
}
.ee-sim__head { max-width: 62ch; margin: 0 auto var(--ee-gap-lg); text-align: center; }
.ee-sim__title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-title);
  font-weight: 400;
  color: #280000;
  margin: 0 0 var(--ee-gap-sm);
  letter-spacing: var(--ee-ls-title);
  line-height: var(--ee-lh-title);
}
.ee-sim__title strong { font-weight: 700; color: #FB2E0A; }
.ee-sim__sub {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: var(--ee-sub);
  font-weight: 400;
  color: rgba(40, 0, 0, 0.62);
  margin: 0;
  line-height: var(--ee-lh-body);
  letter-spacing: -0.005em;
}
.ee-sim__bars {
  display: flex;
  flex-direction: column;
  gap: clamp(12px, 1.6vh, 20px);
}
.ee-sim__bar {
  display: grid;
  grid-template-columns: clamp(56px, 6vw, 96px) 1fr;
  gap: clamp(12px, 1.4vw, 20px);
  align-items: stretch;
  user-select: none;
  -webkit-user-select: none;
}
.ee-sim__chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ee-radius-sm);
  background: transparent;
  color: #280000;
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 700;
  font-size: clamp(20px, 2.4vw, 34px);
}
/* Traçado (borda) em gradiente, sem fundo — máscara pra respeitar o border-radius */
.ee-sim__chip::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 2px;
  background: linear-gradient(135deg, #FB2E0A 0%, #C41E08 55%, #7A0A02 100%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
          mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;
  pointer-events: none;
}
.ee-sim__track {
  position: relative;
  border-radius: var(--ee-radius-sm);
  overflow: hidden;
  min-height: clamp(54px, 8vh, 88px);
  /* track (parte vazia) em rosa claro sobre o fundo branco */
  background: linear-gradient(90deg, #F3D9D3 0%, #EBC8BF 100%);
  /* stroke sutil escuro pra definir a barra no branco */
  border: 1px solid rgba(40, 0, 0, 0.12);
  /* sombra suave (vermelho discreto) pra dar profundidade no branco */
  box-shadow: 0 6px 18px rgba(196, 30, 8, 0.12);
}
.ee-sim__fill {
  position: absolute;
  top: 0; bottom: 0; right: 0;
  left: var(--start, 50%);
  background: linear-gradient(90deg, #FF3B0F 0%, #C41E08 60%, #7A0A02 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: ew-resize;
  touch-action: none; /* nós controlamos o arrasto horizontal do nível */
}
.ee-sim__fill.is-dragging { filter: brightness(1.06); }
/* "Pega" (grip) na borda esquerda do preenchimento — sinaliza que dá pra arrastar */
.ee-sim__fill::before {
  content: "";
  position: absolute;
  left: 8px;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 38%;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.65);
  pointer-events: none;
}
.ee-sim__label {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 700;
  font-size: clamp(18px, 2.2vw, 34px);
  color: #FFFFFF;
  letter-spacing: -0.01em;
  white-space: nowrap;
}
.ee-sim__alert {
  margin: var(--ee-gap-md) 0 0;
  min-height: 1.6em;
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 600;
  font-size: var(--ee-body);
  color: #FB2E0A;
  letter-spacing: -0.005em;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.ee-sim__alert.is-visible { opacity: 1; transform: translateY(0); }

/* Frase-gancho: transição pro próximo bloco (Estruturação Estratégica) */
.ee-sim__hook {
  margin: clamp(20px, 3vh, 40px) 0 0;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(20px, 2.2vw, 34px);
  font-weight: 400;
  color: #280000;
  letter-spacing: -0.015em;
  line-height: 1.3;
  text-align: center;
}
.ee-sim__hook strong { font-weight: 700; }
.ee-sim__hook-dots { color: #FB2E0A; font-weight: 700; }


/* Mobile responsive */
@media (max-width: 900px) {
  .ee-hero { min-height: auto; padding-top: 120px; padding-bottom: 96px; }
  .ee-hero__visual { aspect-ratio: 1; max-width: 380px; }
  .ee-hero__logo { width: 30%; }
}
@media (max-width: 600px) {
  .ee-model-selector__trigger { min-width: 0; width: 100%; }
}

/* ===== FASES DO PROJETO (velocímetro / carrossel) ===== */
.ee-phases { background: #FFFFFF; padding: var(--ee-pad-y-default) var(--ee-pad-x); }
.ee-phases__inner {
  max-width: var(--ee-max-width); width: 100%; margin: 0 auto;
  display: grid; grid-template-columns: 1fr; gap: var(--ee-gap-xl); align-items: center;
}
@media (min-width: 920px) { .ee-phases__inner { grid-template-columns: 1fr 1fr; } }
.ee-phases__title {
  font-family: 'IBM Plex Sans', sans-serif; font-weight: 400; text-transform: none;
  font-size: var(--ee-title); line-height: var(--ee-lh-title); letter-spacing: var(--ee-ls-title);
  color: #280000; margin: 0 0 var(--ee-gap-lg);
}
.ee-phases__bullets { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(14px, 2vh, 22px); }
.ee-phases__bullets li {
  position: relative; padding-left: 22px;
  font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(16px, 1.4vw, 21px);
  font-weight: 500; color: #280000; letter-spacing: -0.01em;
}
.ee-phases__bullets li::before {
  content: ""; position: absolute; left: 0; top: 0.5em;
  width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(135deg, #FB2E0A, #C41E08);
}
.ee-phases__carousel { position: relative; display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; column-gap: clamp(6px,1vw,14px); row-gap: 16px; }
.ee-phases__card {
  grid-column: 2; grid-row: 1; text-align: center;
  border: 2px solid transparent; border-radius: var(--ee-radius-md);
  /* fundo claro no padding-box + stroke de gradiente brand no border-box */
  background:
    linear-gradient(#F6F3F1, #F6F3F1) padding-box,
    linear-gradient(135deg, #FB2E0A 0%, #C41E08 50%, #7A0A02 100%) border-box;
  padding: clamp(24px,3vw,40px) clamp(20px,3vw,44px) clamp(26px,3.2vw,42px);
}
.ee-phases__gauge { position: relative; width: 100%; max-width: clamp(240px,26vw,330px); margin: 0 auto clamp(8px,1.2vw,16px); }
.ee-phases__dial { display: block; width: 100%; height: auto; overflow: visible; }
.ee-phases__needle { transform-box: fill-box; transform-origin: 50% 100%; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
.ee-phases__logo { position: absolute; left: 50%; top: 56%; transform: translate(-50%,-50%); width: 15.5%; height: auto; pointer-events: none; }
.ee-phases__step { font-family: 'IBM Plex Sans', sans-serif; font-size: var(--ee-label); font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: #C41E08; margin: 0 0 4px; }
.ee-phases__name { font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(26px,3vw,40px); font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: #280000; margin: 0 0 clamp(8px,1vw,12px); line-height: 1; }
.ee-phases__metrics { font-family: 'IBM Plex Sans', sans-serif; font-size: var(--ee-label); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(40,0,0,0.45); margin: 0 0 clamp(10px,1.2vw,14px); min-height: 1.2em; }
.ee-phases__desc { font-family: 'IBM Plex Sans', sans-serif; font-size: var(--ee-body-sm); font-weight: 400; line-height: 1.5; color: rgba(40,0,0,0.7); margin: 0 auto; max-width: 44ch; min-height: 8em; }
.ee-phases__nav { grid-row: 1; width: clamp(38px,3vw,46px); height: clamp(38px,3vw,46px); border-radius: 50%; border: 1px solid rgba(40,0,0,0.16); background: #FFFFFF; color: #280000; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s; }
.ee-phases__nav:hover { background: #C41E08; border-color: #C41E08; color: #FFFFFF; transform: scale(1.06); }
.ee-phases__nav--prev { grid-column: 1; }
.ee-phases__nav--next { grid-column: 3; }
.ee-phases__nav svg { width: 20px; height: 20px; }
.ee-phases__dots { grid-column: 2; grid-row: 2; display: flex; justify-content: center; gap: 8px; }
.ee-phases__dot { width: 8px; height: 8px; padding: 0; border: none; border-radius: 50%; background: rgba(40,0,0,0.18); cursor: pointer; transition: background 0.2s, transform 0.2s; }
.ee-phases__dot.is-active { background: #FB2E0A; transform: scale(1.25); }
/* Foco de teclado — mesmo tratamento dos outros controles da página */
.ee-phases__nav:focus-visible,
.ee-phases__dot:focus-visible {
  outline: 2px solid rgba(229, 9, 20, 0.5);
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) { .ee-phases__needle, .ee-phases__nav, .ee-phases__dot { transition: none; } }
@media (max-width: 919px) { .ee-phases__title { text-align: center; } .ee-phases__bullets { align-items: flex-start; max-width: 420px; margin: 0 auto; } }
/* Animações da seção Fases: entrada (stagger) + troca de slide */
@keyframes ee-phases-textin { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.ee-phases.is-armed .ee-phases__title,
.ee-phases.is-armed .ee-phases__bullets li { opacity: 0; transform: translateY(26px); transition: opacity 0.7s cubic-bezier(0.23,1,0.32,1), transform 0.7s cubic-bezier(0.23,1,0.32,1); }
.ee-phases.is-armed .ee-phases__carousel { opacity: 0; transform: translateY(28px) scale(0.985); transition: opacity 0.8s cubic-bezier(0.23,1,0.32,1), transform 0.8s cubic-bezier(0.23,1,0.32,1); }
.ee-phases.is-revealed .ee-phases__title { opacity: 1; transform: none; transition-delay: 0.05s; }
.ee-phases.is-revealed .ee-phases__bullets li { opacity: 1; transform: none; }
.ee-phases.is-revealed .ee-phases__bullets li:nth-child(1) { transition-delay: 0.16s; }
.ee-phases.is-revealed .ee-phases__bullets li:nth-child(2) { transition-delay: 0.28s; }
.ee-phases.is-revealed .ee-phases__bullets li:nth-child(3) { transition-delay: 0.40s; }
.ee-phases.is-revealed .ee-phases__bullets li:nth-child(4) { transition-delay: 0.52s; }
.ee-phases.is-revealed .ee-phases__carousel { opacity: 1; transform: none; transition-delay: 0.22s; }
.ee-phases__card.is-switching .ee-phases__step,
.ee-phases__card.is-switching .ee-phases__name,
.ee-phases__card.is-switching .ee-phases__metrics,
.ee-phases__card.is-switching .ee-phases__desc { animation: ee-phases-textin 0.42s cubic-bezier(0.23,1,0.32,1); }
@media (prefers-reduced-motion: reduce) {
  .ee-phases.is-armed .ee-phases__title, .ee-phases.is-armed .ee-phases__bullets li, .ee-phases.is-armed .ee-phases__carousel { opacity: 1; transform: none; transition: none; }
  .ee-phases__card.is-switching .ee-phases__step, .ee-phases__card.is-switching .ee-phases__name, .ee-phases__card.is-switching .ee-phases__metrics, .ee-phases__card.is-switching .ee-phases__desc { animation: none; }
}

/* === FOOTER — slogan da marca === */
.ee-footer {
  background: #160000;
  padding: clamp(56px, 9vh, 110px) var(--ee-pad-x);
  text-align: center;
}
.ee-footer__line {
  font-family: 'IBM Plex Sans', sans-serif;
  font-weight: 400;
  text-transform: uppercase;
  font-size: clamp(20px, 2.4vw, 38px);
  line-height: 1.1;
  letter-spacing: 0.04em;
  margin: 0;
  padding: 0.06em 0;
  background: linear-gradient(90deg, #FB2E0A 0%, #FF6A00 50%, #FFD60A 100%);
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
</style>
</head>

<body class="home page wp-custom-logo wp-theme-studiosunup">

<div class="wp-site-blocks">

<!-- ============================================================ -->
<!-- SECTION 01 — BRAND                                            -->
<!-- ============================================================ -->
<main class="wp-block-group is-layout-flow wp-block-group-is-layout-flow" id="top">

<!-- ============================================================ -->
<!-- SEÇÃO 01 — HERO                                               -->
<!-- ============================================================ -->
<section id="hero" class="ee-hero ds-bg-gradient" data-hero-state="select" aria-label="Bem-vindo à V4 Company">
  <div class="ee-hero__wipe" aria-hidden="true"></div>

  <!-- ESTADO SELECT: prompt + seletor de modelo (centralizado sobre o gradiente) -->
  <div class="ee-hero__inner">
    <div class="ee-hero__content">
      <p class="ee-hero__select-prompt">Para começar, selecione o <strong>modelo de vendas</strong></p>

      <div class="ee-model-selector" data-state="closed">
        <button type="button"
                class="ee-model-selector__trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label="Escolha seu modelo de vendas">
          <span class="ee-model-selector__label" data-placeholder="Escolha seu modelo de vendas">Escolha seu modelo de vendas</span>
          <svg class="ee-model-selector__chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
        <ul class="ee-model-selector__menu" role="listbox" aria-label="Modelos de vendas disponíveis">
          <li role="option" data-value="pdv" tabindex="-1">PDV</li>
          <li role="option" data-value="inside-sales" tabindex="-1">Inside Sales</li>
          <li role="option" data-value="e-commerce" tabindex="-1">E-commerce</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ESTADO WELCOME: split-screen (painel branco à esquerda + imagem full-height à direita) -->
  <div class="ee-hero__welcome">
    <div class="ee-hero__panel">
      <p class="ee-hero__note ee-hero__note--tl">Somos <strong>Cientistas</strong></p>
      <p class="ee-hero__note ee-hero__note--tr">Inimigos da <em>Inércia</em></p>
      <div class="ee-hero__welcome-block">
        <span class="ee-hero__welcome-lead">Bem-Vindo à</span>
        <h1 class="ee-hero__welcome-title">V4 Company</h1>
        <div class="ee-model-selector ee-model-selector--welcome" data-state="closed">
          <button type="button"
                  class="ee-model-selector__trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-label="Escolha seu modelo de vendas">
            <span class="ee-model-selector__label" data-placeholder="Escolha seu modelo de vendas">Escolha seu modelo de vendas</span>
            <svg class="ee-model-selector__chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
          <ul class="ee-model-selector__menu" role="listbox" aria-label="Modelos de vendas disponíveis">
            <li role="option" data-value="pdv" tabindex="-1">PDV</li>
            <li role="option" data-value="inside-sales" tabindex="-1">Inside Sales</li>
            <li role="option" data-value="e-commerce" tabindex="-1">E-commerce</li>
          </ul>
        </div>
      </div>
      <p class="ee-hero__note ee-hero__note--bl">Nosso negócio é vender o seu</p>
      <p class="ee-hero__note ee-hero__note--br">#GoToIPO2030</p>
    </div>
    <div class="ee-hero__photo">
      <img src="assets/imgherose.webp" alt="Mão segurando o cubo translúcido da V4 Company"/>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- SEÇÃO 02 — AUTORIDADE (stats + quem somos)                    -->
<!-- ============================================================ -->
<section id="autoridade" class="ee-auth" aria-label="Autoridade da V4 Company">
  <div class="ee-auth__inner">

    <!-- Conteúdo (esquerda) -->
    <div class="ee-auth__main">
      <p class="ee-auth__eyebrow">Quem somos?</p>
      <h2 class="ee-auth__who-title">
        <span>MAIOR</span>
        <span>ASSESSORIA</span>
      </h2>
      <p class="ee-auth__who-sub">de Marketing da <strong>América Latina</strong></p>
    </div>

    <!-- Mapa (direita) -->
    <div class="ee-auth__map">
      <img src="assets/MapaV4.webp" alt="Mapa do Brasil com a presença nacional da V4 Company" class="ee-auth__map-img"/>
    </div>

    <!-- Big numbers — faixa full-width abaixo da head + mapa -->
    <div class="ee-auth__stats" role="list">
      <div class="ee-auth__stat" role="listitem">
        <p class="ee-auth__stat-number">+14</p>
        <p class="ee-auth__stat-label">Anos de<br/>mercado</p>
      </div>
      <div class="ee-auth__stat" role="listitem">
        <p class="ee-auth__stat-number">+200</p>
        <p class="ee-auth__stat-label">Franquias<br/>pelo Brasil</p>
      </div>
      <div class="ee-auth__stat" role="listitem">
        <p class="ee-auth__stat-number">+16bi</p>
        <p class="ee-auth__stat-label">Receita gerada para<br/>nossos clientes</p>
      </div>
      <div class="ee-auth__stat" role="listitem">
        <p class="ee-auth__stat-number">+48 mil</p>
        <p class="ee-auth__stat-label">Projetos<br/>atendidos</p>
      </div>
    </div>

  </div>
</section>

<!-- ============================================================ -->
<!-- SEÇÃO — RECONHECIMENTO (badges Google + Meta)                 -->
