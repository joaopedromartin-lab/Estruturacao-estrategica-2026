<!-- SEÇÃO 05 — MÉTODO (planta de receita + 4 pilares)             -->
<!-- ============================================================ -->
<section id="metodo" class="ee-method" aria-label="Nosso método científico">
  <div class="ee-method__inner">

    <!-- Header centralizado -->
    <header class="ee-method__head">
      <h2 class="ee-method__title">Método <strong>V4</strong></h2>
      <p class="ee-method__sub">O Método V4 é uma estratégia utilizada para impulsionar as vendas dos clientes. É composto por quatro pilares: <strong>aquisição, engajamento, monetização e retenção.</strong> Ao contrário do funil de vendas tradicional, essas etapas se conectam e a conversão pode ocorrer em qualquer momento do processo de vendas.</p>
    </header>

    <!-- 4 cards: ícone do pilar acima + ferramentas dentro -->
    <ol class="ee-method__pillars">
      <li class="ee-method__pillar">
        <img class="ee-method__pillar-icon" src="assets/aquisicao.svg" alt="" aria-hidden="true"/>
        <div class="ee-method__pillar-card">
          <h3 class="ee-method__pillar-title">Aquisição</h3>
          <ul class="ee-method__pillar-tools">
            <li class="ee-method__tool"><img src="assets/Meta ads.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Meta Ads</span></li>
            <li class="ee-method__tool"><img src="assets/Googleads.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Google Ads</span></li>
            <li class="ee-method__tool"><img src="assets/Tiktokads.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">TikTok Ads</span></li>
            <li class="ee-method__tool"><i data-lucide="search" aria-hidden="true"></i><span class="ee-method__tool-label">S.E.O.</span></li>
          </ul>
        </div>
      </li>
      <li class="ee-method__pillar">
        <img class="ee-method__pillar-icon" src="assets/engagamento.svg" alt="" aria-hidden="true"/>
        <div class="ee-method__pillar-card">
          <h3 class="ee-method__pillar-title">Engajamento</h3>
          <ul class="ee-method__pillar-tools">
            <li class="ee-method__tool"><img src="assets/criativos.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Criativos</span></li>
            <li class="ee-method__tool"><i data-lucide="shopping-cart" aria-hidden="true"></i><span class="ee-method__tool-label">Sales Pages</span></li>
            <li class="ee-method__tool"><img src="assets/lp.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Landing Pages</span></li>
            <li class="ee-method__tool"><i data-lucide="file-text" aria-hidden="true"></i><span class="ee-method__tool-label">Conteúdo</span></li>
          </ul>
        </div>
      </li>
      <li class="ee-method__pillar">
        <img class="ee-method__pillar-icon" src="assets/monetizacao.svg" alt="" aria-hidden="true"/>
        <div class="ee-method__pillar-card">
          <h3 class="ee-method__pillar-title">Monetização</h3>
          <ul class="ee-method__pillar-tools">
            <li class="ee-method__tool"><i data-lucide="store" aria-hidden="true"></i><span class="ee-method__tool-label">E-commerce</span></li>
            <li class="ee-method__tool"><img src="assets/insidesales.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Inside Sales</span></li>
            <li class="ee-method__tool"><img src="assets/inbound.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Inbound</span></li>
            <li class="ee-method__tool"><img src="assets/timedeevendas.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Time de Vendas</span></li>
          </ul>
        </div>
      </li>
      <li class="ee-method__pillar">
        <img class="ee-method__pillar-icon" src="assets/retencao.svg" alt="" aria-hidden="true"/>
        <div class="ee-method__pillar-card">
          <h3 class="ee-method__pillar-title">Retenção</h3>
          <ul class="ee-method__pillar-tools">
            <li class="ee-method__tool"><img src="assets/emarketing.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">E-mail Marketing</span></li>
            <li class="ee-method__tool"><img src="assets/remarketing.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">Remarketing</span></li>
            <li class="ee-method__tool"><img src="assets/crm.svg" alt="" aria-hidden="true"/><span class="ee-method__tool-label">CRM: RFM, LTV</span></li>
          </ul>
        </div>
      </li>
    </ol>

  </div>
</section>

<!-- ============================================================ -->
<!-- SEÇÃO — FASES DO PROJETO (velocímetro / carrossel)            -->
<!-- ============================================================ -->
<section id="fases" class="ee-phases" aria-label="Fases do projeto">
  <div class="ee-phases__inner">

    <div class="ee-phases__intro">
      <h2 class="ee-phases__title">Fases do projeto</h2>
      <ul class="ee-phases__bullets">
        <li>O que você já tem?</li>
        <li>O que você acredita que falta?</li>
        <li>O que eu percebi que falta?</li>
        <li>Como nós vamos resolver juntos?</li>
      </ul>
    </div>

    <div class="ee-phases__carousel">
      <button type="button" class="ee-phases__nav ee-phases__nav--prev" aria-label="Fase anterior"><i data-lucide="chevron-left" aria-hidden="true"></i></button>
      <div class="ee-phases__card">
        <div class="ee-phases__gauge">
          <svg class="ee-phases__dial" viewBox="0 0 220 124" role="img" aria-label="Velocímetro da fase do projeto">
            <defs>
              <linearGradient id="ph-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#7CC93D"/>
                <stop offset="27%" stop-color="#C6D92E"/>
                <stop offset="50%" stop-color="#FFC400"/>
                <stop offset="73%" stop-color="#FF7A0A"/>
                <stop offset="100%" stop-color="#FB2E0A"/>
              </linearGradient>
            </defs>
            <path d="M 20 110 A 90 90 0 0 1 200 110" fill="none" stroke="url(#ph-grad)" stroke-width="18" stroke-linecap="round"/>
            <g stroke="#280000" stroke-opacity="0.38" stroke-width="3" stroke-linecap="round">
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(-90 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(-72 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(-54 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(-36 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(-18 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(0 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(18 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(36 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(54 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(72 110 110)"/>
              <line x1="110" y1="40" x2="110" y2="52" transform="rotate(90 110 110)"/>
            </g>
            <polygon class="ee-phases__needle" points="110,32 105.5,110 114.5,110" fill="#280000" style="transform:rotate(-90deg)"/>
            <circle cx="110" cy="110" r="8.5" fill="#280000"/>
            <circle cx="110" cy="110" r="3.5" fill="#FFFFFF"/>
          </svg>
        </div>
        <p class="ee-phases__step">STEP V0</p>
        <h3 class="ee-phases__name">ESTRUTURAR</h3>
        <p class="ee-phases__metrics"></p>
        <p class="ee-phases__desc">Nesta etapa, o foco está em estruturar todos os processos e dados necessários para a implementação do nosso processo de vendas.</p>
      </div>
      <button type="button" class="ee-phases__nav ee-phases__nav--next" aria-label="Próxima fase"><i data-lucide="chevron-right" aria-hidden="true"></i></button>
      <div class="ee-phases__dots">
        <button type="button" class="ee-phases__dot is-active" aria-label="Fase 1 — Estruturar"></button>
        <button type="button" class="ee-phases__dot" aria-label="Fase 2 — Indicadores"></button>
        <button type="button" class="ee-phases__dot" aria-label="Fase 3 — Maturar"></button>
        <button type="button" class="ee-phases__dot" aria-label="Fase 4 — Escalar"></button>
      </div>
    </div>

  </div>
</section>
<script id="ee-phases-script">
(function () {
  var sec = document.getElementById('fases');
  if (!sec) return;
  var PHASES = [
    { step: 'STEP V0', name: 'ESTRUTURAR',  metrics: '',                      angle: -67, desc: 'Nesta etapa, o foco está em estruturar todos os processos e dados necessários para a implementação do nosso processo de vendas.' },
    { step: 'STEP V1', name: 'INDICADORES', metrics: 'CAC · LTV · ARPU · ROI', angle: -22, desc: 'Projetos que estão em fase inicial nos processos de vendas através da internet. Ou seja, projetos que não tenham um processo de vendas bem definido, e/ou total clareza dos principais indicadores e métricas do negócio.' },
    { step: 'STEP V2', name: 'MATURAR',     metrics: '',                      angle:  22, desc: 'Projetos que apresentam definições de seus principais indicadores e processos bem estruturados. Ocorre a realização de testes e validações que visam identificar e/ou manter os bons indicadores.' },
    { step: 'STEP V3', name: 'ESCALAR',     metrics: '',                      angle:  67, desc: 'Nesta fase os projetos já apresentam dados e estratégias validadas, portanto, estão aptos para que possamos realizar um aumento no investimento, e buscar mais escalabilidade para o projeto.' }
  ];
  var i = 0;
  var needle = sec.querySelector('.ee-phases__needle');
  var card   = sec.querySelector('.ee-phases__card');
  var elStep = sec.querySelector('.ee-phases__step');
  var elName = sec.querySelector('.ee-phases__name');
  var elMet  = sec.querySelector('.ee-phases__metrics');
  var elDesc = sec.querySelector('.ee-phases__desc');
  var dots   = sec.querySelectorAll('.ee-phases__dot');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var revealed = reduce;   // ponteiro só faz o "sweep" quando a seção entra na tela
  function render(animateText) {
    var p = PHASES[i];
    if (needle) needle.style.transform = 'rotate(' + (revealed ? p.angle : -90) + 'deg)';
    if (elStep) elStep.textContent = p.step;
    if (elName) elName.textContent = p.name;
    if (elMet)  elMet.textContent  = p.metrics;
    if (elDesc) elDesc.textContent = p.desc;
    for (var d = 0; d < dots.length; d++) dots[d].classList[d === i ? 'add' : 'remove']('is-active');
    if (animateText && card && !reduce) {           // crossfade do texto ao trocar de step
      card.classList.remove('is-switching');
      void card.offsetWidth;                         // reflow → re-dispara a animação
      card.classList.add('is-switching');
    }
  }
  function go(n) { i = (n % PHASES.length + PHASES.length) % PHASES.length; render(true); }
  var prev = sec.querySelector('.ee-phases__nav--prev');
  var next = sec.querySelector('.ee-phases__nav--next');
  if (prev) prev.addEventListener('click', function () { go(i - 1); });
  if (next) next.addEventListener('click', function () { go(i + 1); });
  for (var k = 0; k < dots.length; k++) (function (idx) { dots[idx].addEventListener('click', function () { go(idx); }); })(k);
  render(false);

  // Entrada (stagger via CSS) + sweep do ponteiro quando a seção surge na tela
  if (reduce || !('IntersectionObserver' in window)) {
    revealed = true; sec.classList.add('is-revealed'); render(false);
  } else {
    sec.classList.add('is-armed');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        sec.classList.add('is-revealed');
        revealed = true;
        requestAnimationFrame(function () { if (needle) needle.style.transform = 'rotate(' + PHASES[i].angle + 'deg)'; });
        io.unobserve(sec);
      });
    }, { threshold: 0.25 });
    io.observe(sec);
  }
})();
</script>

<!-- ============================================================ -->
<!-- SEÇÃO — SIMULADOR DE PRODUTO (Saber → Ter → Executar → Performar) -->
<!-- ============================================================ -->
<section id="simulador" class="ee-sim" aria-label="Por que saber antes de executar">
  <div class="ee-sim__inner">
    <header class="ee-sim__head">
      <h2 class="ee-sim__title">Por que <strong>saber</strong> antes de <strong>executar?</strong></h2>
      <p class="ee-sim__sub">Cada solução depende da anterior. Tente reorganizar as barras — você vai ver que não dá pra pular etapa.</p>
    </header>

    <div class="ee-sim__bars" id="ee-sim-bars">
      <div class="ee-sim__bar" data-key="performar" style="--start: 62%;">
        <span class="ee-sim__chip" aria-hidden="true">P</span>
        <div class="ee-sim__track"><div class="ee-sim__fill"><span class="ee-sim__label">Performar</span></div></div>
      </div>
      <div class="ee-sim__bar" data-key="executar" style="--start: 50%;">
        <span class="ee-sim__chip" aria-hidden="true">E</span>
        <div class="ee-sim__track"><div class="ee-sim__fill"><span class="ee-sim__label">Executar</span></div></div>
      </div>
      <div class="ee-sim__bar" data-key="ter" style="--start: 34%;">
        <span class="ee-sim__chip" aria-hidden="true">T</span>
        <div class="ee-sim__track"><div class="ee-sim__fill"><span class="ee-sim__label">Ter</span></div></div>
      </div>
      <div class="ee-sim__bar" data-key="saber" style="--start: 17%;">
        <span class="ee-sim__chip" aria-hidden="true">S</span>
        <div class="ee-sim__track"><div class="ee-sim__fill"><span class="ee-sim__label">Saber</span></div></div>
      </div>
    </div>

    <p class="ee-sim__alert" id="ee-sim-alert" role="status" aria-live="polite"></p>

    <p class="ee-sim__hook">É por isso que todo projeto começa por <strong>saber</strong><span class="ee-sim__hook-dots">.</span></p>
  </div>
</section>


<!-- LP MAE: seções a partir de "Estruturacao Estrategica 3.0" (#produto) removidas — pagina termina em #simulador -->

</main>


<!-- ============================================================ -->
<!-- ESTRUTURAÇÃO ESTRATÉGICA — SCRIPTS DA PÁGINA                 -->
<!-- ============================================================ -->
<script id="ee-page-script">
(function () {
  'use strict';

  // ── TRAVA DE SCROLL ATÉ ESCOLHER O MODELO DE VENDAS ──
  // Aplicada já no parse do script (antes do paint) pra evitar flash. É liberada
  // na 1ª seleção de modelo de vendas (ver revealWelcome). Sem persistência: todo
  // reload (F5/Ctrl+R) ou nova visita volta pro seletor antes do "Bem vindo a V4".
  //
  // O navegador, por padrão, restaura a posição de scroll no reload — o que, com a
  // trava, deixaria o usuário "preso" na seção em que estava. Então desligamos a
  // restauração e forçamos o topo, garantindo que todo F5 caia no seletor.
  if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
  window.scrollTo(0, 0);
  document.documentElement.classList.add('ee-scroll-lock');
  window.addEventListener('load', function () {
    if (document.documentElement.classList.contains('ee-scroll-lock')) window.scrollTo(0, 0);
  });

  // ── ESTADO GLOBAL DO MODELO DE VENDAS ──
  // Disponível em window.V4SalesModel para qualquer seção/script ler.
  // Emite 'v4-sales-model-change' em window quando muda.
  var SALES_MODELS = [
    { value: 'pdv',           label: 'PDV' },
    { value: 'inside-sales',  label: 'Inside Sales' },
    { value: 'e-commerce',    label: 'E-commerce' }
  ];

  window.V4SalesModel = {
    value:   null,
    label:   null,
    options: SALES_MODELS,
    get: function () { return { value: this.value, label: this.label }; },
    set: function (value) {
      var model = SALES_MODELS.find(function (m) { return m.value === value; });
      if (!model) return false;
      this.value = model.value;
      this.label = model.label;
      document.body.setAttribute('data-sales-model', model.value);
      window.dispatchEvent(new CustomEvent('v4-sales-model-change', {
        detail: { value: model.value, label: model.label }
      }));
      return true;
    },
    clear: function () {
      this.value = null;
      this.label = null;
      document.body.removeAttribute('data-sales-model');
      window.dispatchEvent(new CustomEvent('v4-sales-model-change', {
        detail: { value: null, label: null }
      }));
    }
  };

  // ── COMPONENTE: SELETOR(ES) DE MODELO DE VENDAS (1+ instâncias, sincronizadas) ──
  document.addEventListener('DOMContentLoaded', function () {
    var selectors = Array.prototype.slice.call(document.querySelectorAll('.ee-model-selector'));
    if (!selectors.length) return;

    function wire(selector) {
      var trigger = selector.querySelector('.ee-model-selector__trigger');
      var menu    = selector.querySelector('.ee-model-selector__menu');
      if (!trigger || !menu) return;
      var options = Array.prototype.slice.call(menu.querySelectorAll('li[role="option"]'));

      function open() {
        selector.setAttribute('data-state', 'open');
        trigger.setAttribute('aria-expanded', 'true');
        var current = menu.querySelector('li.is-selected') || options[0];
        if (current) current.focus({ preventScroll: true });
      }
      function close() {
        selector.setAttribute('data-state', 'closed');
        trigger.setAttribute('aria-expanded', 'false');
      }
      function toggle() {
        if (selector.getAttribute('data-state') === 'open') close(); else open();
      }
      function select(li) {
        window.V4SalesModel.set(li.getAttribute('data-value')); // dispara o evento → sincroniza abaixo
        close();
        trigger.focus();
      }

      trigger.addEventListener('click', toggle);
      trigger.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') { e.preventDefault(); open(); }
      });
      options.forEach(function (li, idx) {
        li.addEventListener('click', function () { select(li); });
        li.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(li); }
          else if (e.key === 'ArrowDown') { e.preventDefault(); options[(idx + 1) % options.length].focus({ preventScroll: true }); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); options[(idx - 1 + options.length) % options.length].focus({ preventScroll: true }); }
          else if (e.key === 'Escape') { e.preventDefault(); close(); trigger.focus(); }
          else if (e.key === 'Tab') { close(); }
        });
      });
      document.addEventListener('click', function (e) { if (!selector.contains(e.target)) close(); });
    }

    selectors.forEach(wire);

    // Sincroniza rótulo + item selecionado de TODOS os seletores quando o modelo muda
    window.addEventListener('v4-sales-model-change', function (e) {
      var val = e.detail && e.detail.value;
      var lbl = e.detail && e.detail.label;
      selectors.forEach(function (selector) {
        var label = selector.querySelector('.ee-model-selector__label');
        if (label && lbl) label.textContent = lbl;
        [].forEach.call(selector.querySelectorAll('li[role="option"]'), function (o) {
          o.classList.toggle('is-selected', o.getAttribute('data-value') === val);
        });
      });
    });

    // Sem seleção padrão/persistência: a página começa travada no hero até o
    // vendedor escolher o modelo (ver revealWelcome). Reload volta pro seletor.
  });

  // ── COUNT-UP ANIMATION (big numbers em .ee-auth__stat-number) ──
  document.addEventListener('DOMContentLoaded', function () {
    var nodes = document.querySelectorAll('.ee-auth__stat-number');
    if (!nodes.length) return;

    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduce) return; // mantém texto original sem animar

    function parse(raw) {
      var m = raw.trim().match(/^(\D*)(\d+)(\D*)$/);
      if (!m) return null;
      return { prefix: m[1], target: parseInt(m[2], 10), suffix: m[3], original: raw };
    }

    // Snapshot do texto original + marca como "pending" pra esconder via CSS até animar
    var snapshots = new Map();
    nodes.forEach(function (el) {
      var p = parse(el.textContent);
      if (!p) return;
      snapshots.set(el, p);
      el.setAttribute('data-counting', 'pending');
    });

    var DURATION = 1800;
    function animate(el, parsed) {
      var start = null;
      function tick(now) {
        if (start === null) start = now;
        var elapsed = now - start;
        var p = Math.min(elapsed / DURATION, 1);
        var eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
        var current = Math.floor(parsed.target * eased);
        el.textContent = parsed.prefix + current + parsed.suffix;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = parsed.original;
      }
      requestAnimationFrame(tick);
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var parsed = snapshots.get(el);
        if (!parsed) { io.unobserve(el); return; }
        el.textContent = parsed.prefix + '0' + parsed.suffix;
        el.removeAttribute('data-counting'); // revela (opacity 1)
        requestAnimationFrame(function () { animate(el, parsed); });
        io.unobserve(el);
      });
    }, { threshold: 0.4 });

    nodes.forEach(function (el) { io.observe(el); });
  });

  // ── HERO: FLUXO DE SELEÇÃO + ANIMAÇÃO DE ENTRADA ──
  // Na carga, só o prompt + o pré-selecionador entram (estado "select"), centralizados.
  // O "Bem vindo a V4" (título + visual) só é revelado quando um modelo de vendas é
  // escolhido — momento em que a trava de scroll também é liberada.
  document.addEventListener('DOMContentLoaded', function () {
    var hero       = document.getElementById('hero');
    var prompt     = document.querySelector('.ee-hero__select-prompt');
    var selector   = document.querySelector('.ee-hero .ee-model-selector');
    var revealEls  = document.querySelectorAll('.ee-hero__welcome-lead, .ee-hero__welcome-title, .ee-hero__note, .ee-hero__panel .ee-model-selector');
    var visual     = document.querySelector('.ee-hero__visual');
    var wipe       = document.querySelector('.ee-hero__wipe');
    if (!hero) return;

    var hasGsap       = typeof gsap !== 'undefined';
    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(el, anim) {
      if (!el) return;
      if (hasGsap) { gsap.set(el, anim || { opacity: 1, y: 0, scale: 1 }); return; }
      el.style.opacity = '1';
      el.style.transform = 'none';
    }

    // Entrada do estado "select": prompt + seletor
    if (hasGsap && !prefersReduce) {
      var tl = gsap.timeline({ delay: 0.15 });
      if (prompt)   tl.to(prompt,   { opacity: 1, y: 0, duration: 0.7,  ease: 'power2.out' }, 0);
      if (selector) tl.to(selector, { opacity: 1, y: 0, duration: 0.65, ease: 'power2.out' }, 0.2);
    } else {
      show(prompt, { opacity: 1, y: 0 });
      show(selector, { opacity: 1, y: 0 });
    }

    // Revela o "Bem vindo a V4" e libera o scroll (roda só uma vez).
    // Transição fluida: o prompt sai suave → o seletor desliza pra nova posição
    // (FLIP, sem "pulo" do reflow) → título + visual entram em crossfade.
    var revealed = false;
    function revealWelcome() {
      if (revealed) return;
      revealed = true;

      // Sem GSAP / motion reduzido: troca direta, sem animação
      if (!hasGsap || prefersReduce) {
        hero.setAttribute('data-hero-state', 'welcome');
        document.documentElement.classList.remove('ee-scroll-lock');
        show(visual);
        [].forEach.call(revealEls, function (s) { show(s); });
        if (typeof ScrollTrigger !== 'undefined') {
          requestAnimationFrame(function () { ScrollTrigger.refresh(); });
        }
        return;
      }

      function enterWelcome() {
        var refresh = function () {
          if (typeof ScrollTrigger !== 'undefined') {
            requestAnimationFrame(function () { ScrollTrigger.refresh(); });
          }
        };
        var goWelcome = function () {
          hero.setAttribute('data-hero-state', 'welcome');
          document.documentElement.classList.remove('ee-scroll-lock');
        };

        // título começa escondido; entra depois que o wipe revelar a hero
        if (revealEls.length) gsap.set(revealEls, { opacity: 0, y: 40 });

        if (!wipe) {
          // sem o painel: troca direta + revela
          goWelcome();
          if (revealEls.length) gsap.to(revealEls, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.14 });
          refresh();
          return;
        }

        // === WIPE "MINHOCA" ===
        // Fase 1: o retângulo nasce fixado na base e cresce até o topo (cobre a seção).
        // Com a seção coberta, troca pro estado welcome (seletor some, imagem aparece) — escondido.
        // Fase 2: fixa no topo e encolhe de baixo pra cima (a "cauda" segue a "cabeça", com leve
        // delay), revelando a hero já montada embaixo.
        var tl = gsap.timeline({ onComplete: refresh });
        tl.set(wipe, { visibility: 'visible', scaleY: 0, transformOrigin: '50% 100%' });
        tl.to(wipe, { scaleY: 1, duration: 0.5, ease: 'power2.inOut' });
        tl.add(goWelcome);                                           // troca escondida atrás do painel
        tl.set(wipe, { transformOrigin: '50% 0%' });                 // fixa no topo
        tl.to(wipe, { scaleY: 0, duration: 0.62, ease: 'power3.inOut' }, '+=0.06');
        tl.set(wipe, { visibility: 'hidden' });
        // headline entra na hero já revelada (sobrepõe levemente o fim do wipe)
        if (revealEls.length) {
          tl.to(revealEls, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.12 }, '-=0.32');
        }
      }

      // 1) Prompt sai suave; 2) ao terminar, entra o estado "welcome"
      if (prompt) {
        gsap.to(prompt, { opacity: 0, y: -16, duration: 0.5, ease: 'power2.inOut', onComplete: enterWelcome });
      } else {
        enterWelcome();
      }
    }

    // Dispara quando um modelo de vendas é escolhido (ignora o "clear")
    window.addEventListener('v4-sales-model-change', function (e) {
      if (e.detail && e.detail.value) revealWelcome();
    });
  });

  // ── SLIDE FIT: cada seção = 1 viewport; o conteúdo escala pra caber (nunca passa nem sobra) ──
  // Envolve o conteúdo "in-flow" de cada seção num .ee-slide__fit e aplica transform:scale
  // pra encaixar exatamente na altura da tela. Fundos absolutos (imagens full-bleed) ficam
  // de fora e cobrem a seção. Só atua em telas >=901px (no mobile mantém o fluxo natural).
  (function () {
    return; /* FLUXO NATURAL — sistema de slide/escala desativado: seções em altura natural */
    var SLIDE_MQ = window.matchMedia('(min-width: 901px)');
    // Seções fora do escalonamento: hero (fluxo próprio), problema (oculta),
    // ecossistema (imagem full-bleed tratada por object-fit no CSS),
    // produto (texto ancorado no rodapé via margin-top:auto — cabe em 100vh),
    // precos e proposta (conteúdo grande — rolam normalmente, sem caber no viewport),
    // simulador (interativo de arrastar — não pode ser escalado por transform),
    // crescer (SVG full-bleed com traçado animado — posicionado, não escalado).
    var SKIP = { hero: 1, problema: 1, ecossistema: 1, produto: 1, precos: 1, proposta: 1, simulador: 1, crescer: 1, reconhecimento: 1, clientes: 1, garantia: 1, cases: 1, recap: 1, definicao: 1, estrutura: 1 };
    var sections = [];

    var ro = (typeof ResizeObserver !== 'undefined') ? new ResizeObserver(function () {
      if (ro.__raf) cancelAnimationFrame(ro.__raf);
      ro.__raf = requestAnimationFrame(fitAll);
    }) : null;

    function wrap(sec) {
      if (sec.__fitWrap) return sec.__fitWrap;
      var w = document.createElement('div');
      w.className = 'ee-slide__fit';
      [].slice.call(sec.childNodes).forEach(function (n) {
        if (n.nodeType === 1) {
          var pos = getComputedStyle(n).position;
          if (pos === 'absolute' || pos === 'fixed') return; // fundos ficam no lugar
        }
        w.appendChild(n);
      });
      sec.appendChild(w);
      sec.__fitWrap = w;
      if (ro) ro.observe(w);
      return w;
    }

    function fit(sec) {
      if (!SLIDE_MQ.matches) { if (sec.__fitWrap) sec.__fitWrap.style.transform = ''; return; }
      if (getComputedStyle(sec).display === 'none') return;
      var w = sec.__fitWrap || wrap(sec);
      var cs = getComputedStyle(sec);
      var avail = sec.clientHeight - (parseFloat(cs.paddingTop) || 0) - (parseFloat(cs.paddingBottom) || 0);
      var needed = w.offsetHeight; // altura natural (offsetHeight ignora o transform já aplicado)
      if (needed <= 0 || avail <= 0) return;
      var scale = avail / needed;
      w.style.transformOrigin = 'center center';
      w.style.transform = scale < 1 ? 'scale(' + scale + ')' : 'none';
    }

    function fitAll() { sections.forEach(fit); }

    function init() {
      sections = [].filter.call(document.querySelectorAll('#top > section'), function (s) {
        return !SKIP[s.id];
      });
      fitAll();
      var rt;
      window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(fitAll, 120); });
      window.addEventListener('load', fitAll);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
      // Conteúdo dependente do modelo (cases/cronograma/proposta) muda de tamanho
      window.addEventListener('v4-sales-model-change', function () { requestAnimationFrame(fitAll); });
      if (SLIDE_MQ.addEventListener) SLIDE_MQ.addEventListener('change', fitAll);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();

  // ── GSAP CHARACTER REVEAL (letra por letra ao entrar na viewport) ──
  document.addEventListener('DOMContentLoaded', function () {
    var targets = document.querySelectorAll('.ee-reveal-chars');
    if (!targets.length) return;
    if (typeof gsap === 'undefined' || typeof Splitting === 'undefined') return;

    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduce) {
      targets.forEach(function (el) { el.setAttribute('data-splitted', ''); });
      return;
    }

    if (typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
    }

    targets.forEach(function (el) {
      // Splitting quebra o textContent em <span class="char"> preservando <strong> e outros wrappers
      Splitting({ target: el, by: 'chars' });
      el.setAttribute('data-splitted', '');

      var chars = el.querySelectorAll('.char');
      if (!chars.length) return;

      // Stagger adaptativo: textos longos animam mais rápido pra não arrastar
      var stagger = chars.length > 60 ? Math.max(0.008, 0.9 / chars.length) : 0.022;

      gsap.to(chars, {
        opacity: 1,
        y: 0,
        duration: 0.55,
        ease: 'power2.out',
        stagger: stagger,
        scrollTrigger: typeof ScrollTrigger !== 'undefined' ? {
          trigger: el,
          start: 'top 82%',
          toggleActions: 'play none none none'
        } : undefined
      });
    });
  });

  // ── MISSÃO: timeline GSAP (eyebrow + VENDER + lista 01-04) ──
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined') return;
    var section = document.getElementById('missao');
    if (!section) return;
    var eyebrow = section.querySelector('.ee-mission__eyebrow');
    var title   = section.querySelector('.ee-mission__title');
    var items   = section.querySelectorAll('.ee-mission__list li');

    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduce) {
      gsap.set([eyebrow, title].filter(Boolean), { opacity: 1, y: 0, scale: 1 });
      gsap.set(items, { opacity: 1, y: 0 });
      return;
    }
    if (typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

    var tl = gsap.timeline({
      scrollTrigger: typeof ScrollTrigger !== 'undefined' ? {
        trigger: section,
        start: 'top 65%',
        toggleActions: 'play none none none'
      } : undefined
    });

    if (eyebrow)      tl.to(eyebrow, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, 0);
    if (title)        tl.to(title,   { opacity: 1, y: 0, scale: 1, duration: 0.55, ease: 'power3.out' }, 0.05);
    if (items.length) tl.to(items,   { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.1 }, 0.3);
  });

  // ── MÉTODO PILARES: animação em onda dos 4 pilares (Aquisição/Engajamento/...) ──
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined') return;
    var pillars = document.querySelectorAll('.ee-method__pillar');
    if (!pillars.length) return;

    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduce) { gsap.set(pillars, { opacity: 1, y: 0 }); return; }

    if (typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

    gsap.to(pillars, {
      opacity: 1, y: 0,
      duration: 0.7,
      ease: 'power3.out',
      stagger: 0.13,
      scrollTrigger: typeof ScrollTrigger !== 'undefined' ? {
        trigger: '.ee-method__pillars',
        start: 'top 82%',
        toggleActions: 'play none none none'
      } : undefined
    });
  });

  // ── CARROSSEL 3D (vanilla port do CircularGallery) ──
  document.addEventListener('DOMContentLoaded', function () {
    var gallery = document.querySelector('.ee-gallery');
    var rotator = document.getElementById('ee-gallery-rotator');
    if (!rotator || !gallery) return;
    var allCards = Array.prototype.slice.call(rotator.querySelectorAll('.ee-gallery__card'));
    if (!allCards.length) return;

    var RADIUS = 600;               // distância dos cards ao centro do rotator
    var dotsWrap = document.getElementById('ee-gallery-dots');

    // Geometria recalculada a cada rebuild (o nº de cards varia por modelo de vendas)
    var cards          = allCards;
    var ITEM_COUNT     = cards.length;
    var ANGLE_PER_ITEM = 360 / ITEM_COUNT;
    var dots           = [];
    var rotation       = 0;
    var animating      = false;

    function frontIndex() {
      var raw = Math.round(-rotation / ANGLE_PER_ITEM);
      return ((raw % ITEM_COUNT) + ITEM_COUNT) % ITEM_COUNT;
    }
    function updateDots() {
      if (!dots.length) return;
      var fi = frontIndex();
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === fi);
        d.setAttribute('aria-selected', i === fi ? 'true' : 'false');
      });
    }

    function updateOpacities() {
      var totalRotation = rotation % 360;
      cards.forEach(function (card, i) {
        var itemAngle      = i * ANGLE_PER_ITEM;
        var relativeAngle  = (itemAngle + totalRotation + 360) % 360;
        var normalizedAng  = Math.abs(relativeAngle > 180 ? 360 - relativeAngle : relativeAngle);
        var opacity = Math.max(0.3, 1 - (normalizedAng / 180));
        card.style.opacity = opacity;
      });
    }

    function applyRotation() {
      rotator.style.transform = 'rotateY(' + rotation + 'deg)';
      updateOpacities();
      updateDots();
    }

    // Remonta o círculo com os cards válidos para o modelo de vendas atual.
    // Cards com data-hide-for="<modelo>" saem do círculo e os restantes são
    // redistribuídos em 360°, sem buracos. Os dots são recriados junto.
    function rebuild(model) {
      animating = false; // cancela qualquer animação em curso

      cards = allCards.filter(function (card) {
        var hideFor = card.getAttribute('data-hide-for');
        var hidden  = !!model && hideFor === model;
        card.style.display = hidden ? 'none' : '';
        return !hidden;
      });
      if (!cards.length) return;

      ITEM_COUNT     = cards.length;
      ANGLE_PER_ITEM = 360 / ITEM_COUNT;

      cards.forEach(function (card, i) {
        card.style.transform = 'rotateY(' + (i * ANGLE_PER_ITEM) + 'deg) translateZ(' + RADIUS + 'px)';
      });

      // ── Dots de paginação (1 por card visível) ──
      dots = [];
      if (dotsWrap) {
        dotsWrap.innerHTML = '';
        cards.forEach(function (card, i) {
          var d = document.createElement('button');
          d.type = 'button';
          d.className = 'ee-gallery__dot';
          d.setAttribute('role', 'tab');
          d.setAttribute('aria-label', 'Ir para o card ' + (i + 1));
          d.addEventListener('click', function () { goToIndex(i); });
          dotsWrap.appendChild(d);
          dots.push(d);
        });
      }

      rotation = 0;
      applyRotation();
    }

    // Anima a rotação até um alvo com easing (easeOutCubic), sem libs externas.
    function animateTo(target, duration) {
      var startRot = rotation;
      var change   = target - startRot;
      var startTs  = null;
      animating = true;
      function step(ts) {
        if (!animating) return;            // rebuild cancelou a animação
        if (startTs === null) startTs = ts;
        var t = Math.min(1, (ts - startTs) / duration);
        var eased = 1 - Math.pow(1 - t, 3);
        rotation = startRot + change * eased;
        applyRotation();
        if (t < 1) {
          requestAnimationFrame(step);
        } else {
          rotation = target;
          applyRotation();
          animating = false;
        }
      }
      requestAnimationFrame(step);
    }

    // Gira exatamente 1 card por clique (ignora cliques durante a animação)
    function rotateBy(delta) {
      if (animating) return;
      animateTo(rotation + delta, 520);
    }

    // Gira até trazer o card `i` pra frente, pelo caminho mais curto
    function goToIndex(i) {
      if (animating) return;
      var targetBase = -i * ANGLE_PER_ITEM;            // rotação que põe o card i na frente
      var diff = ((targetBase - rotation) % 360 + 540) % 360 - 180; // menor delta [-180,180]
      if (Math.abs(diff) < 0.5) return;                // já está na frente
      animateTo(rotation + diff, 520);
    }

    var prevBtn = gallery.querySelector('.ee-gallery__nav--prev');
    var nextBtn = gallery.querySelector('.ee-gallery__nav--next');
    if (prevBtn) prevBtn.addEventListener('click', function () { rotateBy(+ANGLE_PER_ITEM); });
    if (nextBtn) nextBtn.addEventListener('click', function () { rotateBy(-ANGLE_PER_ITEM); });

    // Carrossel manual: gira SÓ ao clicar nas setas (sem auto-rotate, sem drag).
    rebuild((window.V4SalesModel && window.V4SalesModel.value) || null);

    window.addEventListener('v4-sales-model-change', function (e) {
      rebuild((e.detail && e.detail.value) || null);
    });
  });

  // ── PRODUTO: zoom-in scroll-driven na imagem de fundo ──
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined') return;
    var bg = document.querySelector('.ee-product__bg');
    if (!bg) return;

    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduce) { gsap.set(bg, { scale: 1 }); return; }

    if (typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

    gsap.fromTo(bg,
      { scale: 1.6 },
      {
        scale: 1,
        ease: 'none',
        scrollTrigger: typeof ScrollTrigger !== 'undefined' ? {
          trigger: '.ee-product',
          start: 'top bottom',  // estado inicial (grande) quando a seção entra pela base
          end:   'center center', // estado final (normal) quando o centro da seção atinge o centro da viewport
          scrub: 0.5
        } : undefined
      }
    );
  });

  // ── PRODUTO: logo + sub fade-up sequencial ──
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined') return;
    var section = document.getElementById('produto');
    if (!section) return;
    var logo = section.querySelector('.ee-product__logo');
    var sub  = section.querySelector('.ee-product__sub');

    var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduce) {
      gsap.set([logo, sub].filter(Boolean), { opacity: 1, y: 0 });
      return;
    }
    if (typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

    var tl = gsap.timeline({
      scrollTrigger: typeof ScrollTrigger !== 'undefined' ? {
        trigger: section,
        start: 'top 65%',
        toggleActions: 'play none none none'
      } : undefined
    });

    if (logo) tl.to(logo, { opacity: 1, y: 0, duration: 0.95, ease: 'power3.out' }, 0);
    if (sub)  tl.to(sub,  { opacity: 1, y: 0, duration: 0.7,  ease: 'power2.out' }, 0.3);
  });


  // ── CASES DE SUCESSO: grupo varia por modelo, slider interno por grupo ──
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('cases');
    if (!section) return;
    var groups = section.querySelectorAll('.ee-cases__group');
    if (!groups.length) return;

    // 2 cards lado a lado (sem carrossel). Mostra/esconde o grupo conforme V4SalesModel
    // e atualiza o rótulo do modelo no título ("Alguns cases que temos de ___").
    var titleModelEl = section.querySelector('[data-cases-model]');
    var CASE_LABELS = { 'pdv': 'PDV', 'inside-sales': 'Inside Sales', 'e-commerce': 'E-commerce' };

    function updateGroup() {
      var model = (window.V4SalesModel && window.V4SalesModel.value) || null;
      if (!model) {
        section.setAttribute('data-state', 'empty');
        groups.forEach(function (g) { g.classList.remove('is-active'); });
        return;
      }
      var anyActive = false;
      groups.forEach(function (g) {
        var matches = g.getAttribute('data-model') === model;
        g.classList.toggle('is-active', matches);
        if (matches) anyActive = true;
      });
      if (titleModelEl && CASE_LABELS[model]) titleModelEl.textContent = CASE_LABELS[model];
      section.setAttribute('data-state', anyActive ? 'filled' : 'empty');
    }
    window.addEventListener('v4-sales-model-change', updateGroup);
    updateGroup();
  });


  // ── SIMULADOR DE PRODUTO (#simulador): arrastar o NÍVEL (gradiente) na horizontal ──
  // Cada barra tem um nível = largura do preenchimento. Arrasta-se o gradiente na
  // horizontal pra ajustar. A dependência limita o nível: uma categoria não pode passar
  // do nível da que ela depende — ao tentar, o nível trava e mostra o alerta.
  // Ordem visual (top→bottom): 0 Performar, 1 Executar, 2 Ter, 3 Saber.
  // start% = borda esquerda do preenchimento (menor start = mais cheio = nível maior).
  // Invariante: start0 >= start1 >= start2 >= start3 (Saber é a base, mais cheia).
  document.addEventListener('DOMContentLoaded', function () {
    var wrap = document.getElementById('ee-sim-bars');
    if (!wrap) return;
    var alertEl = document.getElementById('ee-sim-alert');
    var bars = [].slice.call(wrap.querySelectorAll('.ee-sim__bar'));
    if (!bars.length) return;

    // Mensagens por fronteira de dependência (i | i+1):
    var MESSAGES = [
      'Não dá pra PERFORMAR algo que ainda não está rodando.',     // 0 Performar | 1 Executar
      'Não dá pra EXECUTAR sem ter uma base montada.',             // 1 Executar | 2 Ter
      'Não dá pra TER algo sem saber o porquê daquilo.'            // 2 Ter | 3 Saber
    ];
    var MIN = 0, MAX = 86; // limite mínimo 0 = dá pra preencher o trilho inteiro (sem sobrar marrom)

    var starts = bars.map(function (bar) {
      return parseFloat(getComputedStyle(bar).getPropertyValue('--start')) || 50;
    });
    function apply(i) { bars[i].style.setProperty('--start', starts[i] + '%'); }

    var alertTimer;
    function showAlert(msg) {
      if (!alertEl || !msg) return;
      alertEl.textContent = msg;
      alertEl.classList.add('is-visible');
      clearTimeout(alertTimer);
      alertTimer = setTimeout(function () { alertEl.classList.remove('is-visible'); }, 2600);
    }

    function pointerX(e) {
      if (e.touches && e.touches[0]) return e.touches[0].clientX;
      if (e.changedTouches && e.changedTouches[0]) return e.changedTouches[0].clientX;
      return e.clientX;
    }

    var drag = null;
    function onMove(e) {
      if (!drag) return;
      var i = drag.i;
      var want = drag.startStart + (pointerX(e) - drag.downX) / drag.trackW * 100;
      var lower = (i < bars.length - 1) ? starts[i + 1] : MIN; // não pode ficar mais cheio que a base
      var upper = (i > 0) ? starts[i - 1] : MAX;               // não pode ficar menos cheio que o dependente
      if (want < lower) { want = lower; showAlert(MESSAGES[i]); }            // bateu na base (dependência)
      else if (want > upper) { want = upper; showAlert(MESSAGES[i - 1]); }   // bateu no dependente
      starts[i] = want;
      apply(i);
      if (e.cancelable) e.preventDefault();
    }
    function onEnd() {
      if (!drag) return;
      drag.fill.classList.remove('is-dragging');
      drag = null;
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onEnd);
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onEnd);
      document.removeEventListener('touchcancel', onEnd);
    }
    function startDrag(e, bar, fill) {
      var track = bar.querySelector('.ee-sim__track');
      drag = {
        i: bars.indexOf(bar),
        fill: fill,
        downX: pointerX(e),
        startStart: starts[bars.indexOf(bar)],
        trackW: track.getBoundingClientRect().width || 1
      };
      fill.classList.add('is-dragging');
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onEnd);
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onEnd);
      document.addEventListener('touchcancel', onEnd);
    }

    bars.forEach(function (bar) {
      var fill = bar.querySelector('.ee-sim__fill');
      if (!fill) return;
      fill.addEventListener('mousedown', function (e) { e.preventDefault(); startDrag(e, bar, fill); });
      fill.addEventListener('touchstart', function (e) { startDrag(e, bar, fill); }, { passive: true });
    });
  });

  // ── CRONOGRAMA (#cronograma): tabs das semanas + setas (sem loop circular) ──
  document.addEventListener('DOMContentLoaded', function () {
    var tabs   = document.querySelectorAll('.ee-roadmap__tab');
    if (!tabs.length) return;
    var panels = document.querySelectorAll('.ee-roadmap__week');
    var prevBtn = document.getElementById('ee-roadmap-prev');
    var nextBtn = document.getElementById('ee-roadmap-next');

    function currentIndex() {
      for (var i = 0; i < tabs.length; i++) {
        if (tabs[i].classList.contains('is-active')) return i;
      }
      return 0;
    }
    function updateArrows() {
      var idx = currentIndex();
      if (prevBtn) prevBtn.disabled = (idx === 0);
      if (nextBtn) nextBtn.disabled = (idx === tabs.length - 1);
    }
    function activate(week) {
      tabs.forEach(function (t) {
        var isActive = t.getAttribute('data-week') === week;
        t.classList.toggle('is-active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        t.setAttribute('tabindex', isActive ? '0' : '-1');
      });
      panels.forEach(function (p) {
        p.classList.toggle('is-active', p.getAttribute('aria-labelledby') === 'ee-roadmap-tab-' + week);
      });
      updateArrows();
    }
    function step(delta) {
      var idx = currentIndex() + delta;
      if (idx < 0 || idx >= tabs.length) return; // bloqueia nas pontas
      activate(tabs[idx].getAttribute('data-week'));
    }

    tabs.forEach(function (tab, idx) {
      tab.addEventListener('click', function () {
        activate(tab.getAttribute('data-week'));
      });
      tab.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          var nextIdx = Math.min(idx + 1, tabs.length - 1);
          activate(tabs[nextIdx].getAttribute('data-week'));
          tabs[nextIdx].focus();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          var prevIdx = Math.max(idx - 1, 0);
          activate(tabs[prevIdx].getAttribute('data-week'));
          tabs[prevIdx].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          activate(tabs[0].getAttribute('data-week'));
          tabs[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          activate(tabs[tabs.length - 1].getAttribute('data-week'));
          tabs[tabs.length - 1].focus();
        }
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', function () { step(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { step( 1); });

    // Estado inicial das setas
    updateArrows();
  });

  // ── CRONOGRAMA (#cronograma): Semana 3 sincronizada com V4SalesModel ──
  document.addEventListener('DOMContentLoaded', function () {
    var variants = document.querySelectorAll('.ee-roadmap__week3-variant');
    if (!variants.length) return;

    function updateCronogramaWeek3() {
      var model = (window.V4SalesModel && window.V4SalesModel.value) || null;
      var matched = false;
      variants.forEach(function (el) {
        var v = el.getAttribute('data-week3-variant');
        var shouldShow = (v === model);
        el.classList.toggle('is-shown', shouldShow);
        if (shouldShow) matched = true;
      });
      // Se nenhum modelo selecionado (ou inválido), exibe o fallback "prompt"
      if (!matched) {
        var prompt = document.querySelector('.ee-roadmap__week3-variant[data-week3-variant="prompt"]');
        if (prompt) prompt.classList.add('is-shown');
      } else {
        var prompt2 = document.querySelector('.ee-roadmap__week3-variant[data-week3-variant="prompt"]');
        if (prompt2) prompt2.classList.remove('is-shown');
      }
    }

    updateCronogramaWeek3();
    window.addEventListener('v4-sales-model-change', updateCronogramaWeek3);
  });

  // ── RECAP (#recap): Semana 3 sincronizada com V4SalesModel ──
  document.addEventListener('DOMContentLoaded', function () {
    var variants = document.querySelectorAll('.ee-recap__week3-variant');
    if (!variants.length) return;

    function updateRecapWeek3() {
      var model = (window.V4SalesModel && window.V4SalesModel.value) || null;
      var matched = false;
      variants.forEach(function (el) {
        var v = el.getAttribute('data-week3-variant');
        var shouldShow = (v === model);
        el.classList.toggle('is-shown', shouldShow);
        if (shouldShow) matched = true;
      });
      if (!matched) {
        var prompt = document.querySelector('.ee-recap__week3-variant[data-week3-variant="prompt"]');
        if (prompt) prompt.classList.add('is-shown');
      } else {
        var prompt2 = document.querySelector('.ee-recap__week3-variant[data-week3-variant="prompt"]');
        if (prompt2) prompt2.classList.remove('is-shown');
      }
    }

    updateRecapWeek3();
    window.addEventListener('v4-sales-model-change', updateRecapWeek3);
  });

