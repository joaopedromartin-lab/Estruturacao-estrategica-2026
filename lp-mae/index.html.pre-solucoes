        <img class="ee-recognition__badge ee-recognition__badge--kommo" src="assets/kommoCrm.png" alt="Kommo Partner"/>
        <img class="ee-recognition__badge ee-recognition__badge--hex ee-recognition__badge--tray" src="assets/tray.svg" alt="Tray — Parceiro Diamante"/>
        <img class="ee-recognition__badge ee-recognition__badge--hubspot" src="assets/hubspot.png" alt="HubSpot Certified Partner"/>
      </div>
      <div class="ee-recognition__col ee-recognition__col--offset">
        <img class="ee-recognition__badge ee-recognition__badge--google" src="assets/GOOGLE PARTNER PREMIER 2022.png" alt="Google Partner"/>
        <img class="ee-recognition__badge ee-recognition__badge--meta" src="assets/META CERTIFIED COMPANY.png" alt="Meta Business Partner"/>
        <img class="ee-recognition__badge ee-recognition__badge--hex ee-recognition__badge--facebook" src="assets/Facebook.svg" alt="Facebook Blueprint Certification"/>
      </div>
    </div>
  </div>
</section>

